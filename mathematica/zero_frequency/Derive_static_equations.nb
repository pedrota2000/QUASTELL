Cell[CellGroupData[{

Cell["6. Compare with the solver coefficients", "Section",ExpressionUUID->"5f535e12-e842-4ddf-a1e6-80b4f498c27e"],

Cell["\<\
Convert the solver notation to continuous functions: D.g becomes g'(u) and \
D.psi becomes psi'(u). Compare all 36 entries, including zeros. Each residual \
below must vanish.\
\>", "Text",ExpressionUUID->"e147d07e-9708-43b4-9bd4-954fdb11832c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"reference", " ", "=", " ", 
    RowBox[{"{", "\n", "  ", 
     RowBox[{
      RowBox[{"\[ScriptCapitalA]", "[", 
       RowBox[{
       "u", ",", " ", "dd", ",", " ", "dd2", ",", " ", "bgF", ",", " ", "bgG",
         ",", " ", "bgPsi", ",", " ", "V", ",", " ", "T"}], "]"}], ",", "\n", 
      "  ", 
      RowBox[{"\[ScriptCapitalB]", "[", 
       RowBox[{
       "u", ",", " ", "dd", ",", " ", "dd2", ",", " ", "bgF", ",", " ", "bgG",
         ",", " ", "bgPsi", ",", " ", "V", ",", " ", "T"}], "]"}], ",", "\n", 
      "  ", 
      RowBox[{"\[ScriptCapitalC]", "[", 
       RowBox[{
       "u", ",", " ", "dd", ",", " ", "dd2", ",", " ", "bgF", ",", " ", "bgG",
         ",", " ", "bgPsi", ",", " ", "V", ",", " ", "T"}], "]"}]}], "\n", 
     "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"reference", " ", "=", " ", 
    RowBox[{
     RowBox[{"reference", " ", "/.", " ", 
      RowBox[{"{", "\n", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"HoldPattern", "[", 
          RowBox[{"Dot", "[", 
           RowBox[{"dd", ",", " ", "bgG"}], "]"}], "]"}], " ", "->", " ", 
         RowBox[{
          RowBox[{"g", "'"}], "[", "u", "]"}]}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"HoldPattern", "[", 
          RowBox[{"Dot", "[", 
           RowBox[{"dd", ",", " ", "bgPsi"}], "]"}], "]"}], " ", "->", " ", 
         RowBox[{
          RowBox[{"\[Psi]", "'"}], "[", "u", "]"}]}]}], "\n", "}"}]}], " ", "/.",
      " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"bgF", " ", "->", " ", 
        RowBox[{"f", "[", "u", "]"}]}], ",", " ", 
       RowBox[{"bgG", " ", "->", " ", 
        RowBox[{"g", "[", "u", "]"}]}], ",", " ", 
       RowBox[{"bgPsi", " ", "->", " ", 
        RowBox[{"\[Psi]", "[", "u", "]"}]}]}], "}"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"coefficientResidual", " ", "=", " ", 
    RowBox[{"FullSimplify", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Acoeff", ",", " ", "Bcoeff", ",", " ", "Ccoeff"}], "}"}], 
       " ", "-", " ", "reference"}], ",", " ", "assumptions"}], "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"checksCoefficients", " ", "=", " ", 
    RowBox[{"Table", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"TrueQ", "[", 
           RowBox[{"#", " ", "==", " ", "0"}], "]"}], " ", "&"}], " ", "/@", 
         " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"coefficientResidual", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "]"}]}], ")"}]}], ",", "\n", "  ", 
      
      RowBox[{"{", 
       RowBox[{"j", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"(", 
      RowBox[{"And", " ", "@@", " ", "checksCoefficients"}], ")"}]}], ",", 
    "\n", "  ", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<Coefficient comparison failed: \>\"", ",", " ", 
       "coefficientResidual"}], "]"}], ";", " ", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], 
  ";"}], "\n", "checksCoefficients"}], "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"5a6dc5c9-1c11-428e-b6a3-629e1f31afcc"],

