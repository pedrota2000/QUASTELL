 CellLabel->"In[4]:=",ExpressionUUID->"c36fa0ef-254d-46e0-a216-8d8d9a80ec41"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Static limit and background variables", "Section",ExpressionUUID->"a21ae12b-4165-473e-a26a-60417d67e20d"],

Cell["\<\
Set omega = 0. Rewrite the EF background functions as A = f g and S = zeta = \
Sqrt[g]. At zero frequency no time-dependent phase is needed for this change \
of time coordinate.\
\>", "Text",ExpressionUUID->"5cb89294-1951-454c-913e-ade216715511"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"assumptions", " ", "=", " ", 
    RowBox[{
     RowBox[{"0", " ", "<", " ", "u", " ", "<", " ", "1"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"g", "[", "u", "]"}], " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"T", " ", ">", " ", "0"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eqsStatic", " ", "=", " ", 
    RowBox[{"eqsEF", " ", "/.", " ", 
     RowBox[{"\[Omega]", " ", "->", " ", "0"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ToSchwarchildCoords", " ", "=", " ", 
    RowBox[{"{", "\n", "  ", 
     RowBox[{
      RowBox[{"A", " ", "->", " ", 
       RowBox[{"Function", "[", 
        RowBox[{"u", ",", " ", 
         RowBox[{
          RowBox[{"f", "[", "u", "]"}], " ", 
          RowBox[{"g", "[", "u", "]"}]}]}], "]"}]}], ",", "\n", "  ", 
      RowBox[{"S", " ", "->", " ", 
       RowBox[{"Function", "[", 
        RowBox[{"u", ",", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"g", "[", "u", "]"}], "]"}]}], "]"}]}], ",", "\n", "  ", 
      RowBox[{"\[Zeta]", " ", "->", " ", 
       RowBox[{"Function", "[", 
        RowBox[{"u", ",", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"g", "[", "u", "]"}], "]"}]}], "]"}]}]}], "\n", "}"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"eqsBackground", " ", "=", " ", 
   RowBox[{"Simplify", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"eqsStatic", " ", "/.", " ", "ToSchwarchildCoords"}], ",", " ", 
     "assumptions"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"f50ce3e6-c43c-4ad5-9767-fa190b30830c"],

Cell["\<\
The numerical background stores psi(u), with physical scalar phi(u) = u \
psi(u). The solver perturbations are z1 = ZPhi/u and z2 = u^2 Z2. Replacing \
function heads also transforms their derivatives.\
\>", "Text",ExpressionUUID->"12230fb2-eeb0-4c2b-9b62-c0a278b01473"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rescalings", " ", "=", " ", 
    RowBox[{"{", "\n", "  ", 
     RowBox[{
      RowBox[{"\[Phi]", " ", "->", " ", 
       RowBox[{"Function", "[", 
        RowBox[{"u", ",", " ", 
         RowBox[{"u", " ", 
          RowBox[{"\[Psi]", "[", "u", "]"}]}]}], "]"}]}], ",", "\n", "  ", 
      RowBox[{"Z\[Phi]", " ", "->", " ", 
       RowBox[{"Function", "[", 
        RowBox[{"u", ",", " ", 
         RowBox[{"u", " ", 
          RowBox[{"z1", "[", "u", "]"}]}]}], "]"}]}], ",", "\n", "  ", 
      RowBox[{"Z2", " ", "->", " ", 
       RowBox[{"Function", "[", 
        RowBox[{"u", ",", " ", 
         RowBox[{
          RowBox[{"z2", "[", "u", "]"}], "/", 
          RowBox[{"u", "^", "2"}]}]}], "]"}]}]}], "\n", "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"eqsRescaled", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"eqsBackground", " ", "/.", " ", "rescalings"}], ",", " ", 
     "assumptions"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"810082bf-7cc5-4e2a-83c8-fb271de5478c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Momentum and equation normalization", "Section",ExpressionUUID->"76547294-6738-4246-8639-5f8122c4b836"],

Cell["\<\
k is the momentum appearing in the Fourier ansatz. Define q = k/(2 Pi T); the \
generalized eigenvalue is lambda = q^2. Multiplying the two equations by 4 \
and 4 Sqrt[g], respectively, fixes the normalization used by the static \
solver.\
\>", "Text",ExpressionUUID->"c7a1dc54-cb6c-4895-8d51-537233395567"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ToDimensionlessQuant", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{"k", " ", "->", " ", 
      RowBox[{"2", " ", "Pi", " ", "T", " ", "q"}]}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eqsSolver", " ", "=", " ", 
    RowBox[{"Simplify", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"4", ",", " ", 
         RowBox[{"4", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"g", "[", "u", "]"}], "]"}]}]}], "}"}], " ", 
       RowBox[{"(", 
        RowBox[{"eqsRescaled", " ", "/.", " ", "ToDimensionlessQuant"}], 
        ")"}]}], ",", "\n", "  ", "assumptions"}], "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Check", " ", "that", " ", "the", " ", "dependence", " ", "on", " ", "q", 
    " ", "is", " ", "even", " ", "and", " ", "at", " ", "most", " ", 
    RowBox[{"quartic", "."}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"checksMomentum", " ", "=", " ", 
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"PolynomialQ", "[", 
          RowBox[{"#", ",", " ", "q"}], "]"}], " ", "&"}], " ", "/@", " ", 
        "eqsSolver"}], ")"}]}], ",", "\n", "  ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"TrueQ", "[", 
          RowBox[{"#", " ", "==", " ", "0"}], "]"}], " ", "&"}], " ", "/@", 
        " ", 
        RowBox[{"Simplify", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"eqsSolver", " ", "-", " ", 
           RowBox[{"(", 
            RowBox[{"eqsSolver", " ", "/.", " ", 
             RowBox[{"q", " ", "->", " ", 
              RowBox[{"-", "q"}]}]}], ")"}]}], ",", " ", "assumptions"}], 
         "]"}]}], ")"}]}], ",", "\n", "  ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"TrueQ", "[", 
          RowBox[{
           RowBox[{"Exponent", "[", 
            RowBox[{"#", ",", " ", "q"}], "]"}], " ", "<=", " ", "4"}], "]"}],
          " ", "&"}], " ", "/@", " ", "eqsSolver"}], ")"}]}]}], "\n", "}"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"(", 
      RowBox[{"And", " ", "@@", " ", "checksMomentum"}], ")"}]}], ",", "\n", 
    "  ", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<Unexpected momentum dependence: \>\"", ",", " ", 
       "checksMomentum"}], "]"}], ";", " ", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], 
  ";"}], "\n", "checksMomentum"}], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"f9e8d511-4718-482b-9ef2-7c69ca2ff13f"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"True", ",", "True", ",", "True"}], "}"}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{4.00254612869524*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"63d0fe61-7f74-4112-86ad-f191b8a0467e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Extract the differential-operator coefficients", "Section",ExpressionUUID->"cc5d172a-6fea-4a7e-bfc4-8194c335f0e5"],

Cell["\<\
Write each equation as Sum_j (A_ij z_j'' + B_ij z_j' + C_ij z_j) = 0. The \
first index of Acoeff, Bcoeff and Ccoeff labels powers {1, lambda, lambda^2}; \
the second labels the equation and the third the perturbation {z1, z2}.\
\>", "Text",ExpressionUUID->"c396758b-9302-4681-8efa-120b737e7342"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fieldsZ", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"z1", ",", " ", "z2"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eqsExpanded", " ", "=", " ", 
    RowBox[{"Expand", "[", "eqsSolver", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Acoeff", " ", "=", " ", 
    RowBox[{"Table", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{
          RowBox[{"Coefficient", "[", 
           RowBox[{
            RowBox[{"eqsExpanded", "[", 
             RowBox[{"[", "a", "]"}], "]"}], ",", " ", "q", ",", " ", 
            RowBox[{"2", " ", "p"}]}], "]"}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"fieldsZ", "[", 
              RowBox[{"[", "b", "]"}], "]"}], "'"}], "'"}], "[", "u", "]"}]}],
          "]"}], ",", " ", "assumptions"}], "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "0", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
