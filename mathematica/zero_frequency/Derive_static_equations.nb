                   "[", "\n", "          ", 
                   RowBox[{"u", "*", "\[Psi]"}], "]"}]}], ")"}]}], " ", "+", 
               " ", 
               RowBox[{"3", "*", 
                RowBox[{"u", "^", "2"}], "*", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"D", " ", ".", " ", "g"}], ")"}], "^", "2"}], "*", 
                "\n", "        ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Derivative", "[", "1", "]"}], "[", "V", "]"}], "[", 
                 RowBox[{"u", "*", "\[Psi]"}], "]"}]}], " ", "+", " ", "\n", 
               "       ", 
               RowBox[{"4", "*", 
                RowBox[{"g", "^", "2"}], "*", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", "12"}], "*", "u", "*", 
                   RowBox[{"(", 
                    RowBox[{"\[Psi]", " ", "+", " ", 
                    RowBox[{"u", "*", 
                    RowBox[{"D", " ", ".", " ", "\[Psi]"}]}]}], ")"}], "*", 
                   "\n", "          ", 
                   RowBox[{"V", "[", 
                    RowBox[{"u", "*", "\[Psi]"}], "]"}]}], " ", "+", " ", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"3", " ", "+", " ", 
                    RowBox[{
                    RowBox[{"u", "^", "2"}], "*", 
                    RowBox[{"\[Psi]", "^", "2"}]}], " ", "+", " ", "\n", 
                    "           ", 
                    RowBox[{"2", "*", 
                    RowBox[{"u", "^", "3"}], "*", "\[Psi]", "*", 
                    RowBox[{"D", " ", ".", " ", "\[Psi]"}]}], " ", "+", " ", 
                    "\n", "           ", 
                    RowBox[{
                    RowBox[{"u", "^", "4"}], "*", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"D", " ", ".", " ", "\[Psi]"}], ")"}], "^", 
                    "2"}]}]}], ")"}], "*", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Derivative", "[", "1", "]"}], "[", "V", "]"}], 
                    "[", "\n", "           ", 
                    RowBox[{"u", "*", "\[Psi]"}], "]"}]}]}], ")"}]}]}], 
              ")"}]}]}], ")"}]}], ",", " ", 
         RowBox[{
          RowBox[{"-", "36"}], "*", "g", "*", 
          RowBox[{"Pi", "^", "4"}], "*", 
          RowBox[{"T", "^", "4"}], "*", 
          RowBox[{"u", "^", "2"}], "*", "\n", "    ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "2"}], "*", "g"}], " ", "+", " ", 
             RowBox[{"u", "*", 
              RowBox[{"D", " ", ".", " ", "g"}]}]}], ")"}], "^", "2"}], "*", 
          "\n", "    ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"f", "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "12"}], "*", "g", "*", "u", "*", 
                RowBox[{"D", " ", ".", " ", "g"}]}], " ", "+", " ", 
               RowBox[{"3", "*", 
                RowBox[{"u", "^", "2"}], "*", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"D", " ", ".", " ", "g"}], ")"}], "^", "2"}]}], " ",
                "+", " ", "\n", "       ", 
               RowBox[{"4", "*", 
                RowBox[{"g", "^", "2"}], "*", 
                RowBox[{"(", 
                 RowBox[{"3", " ", "+", " ", 
                  RowBox[{
                   RowBox[{"u", "^", "2"}], "*", 
                   RowBox[{"\[Psi]", "^", "2"}]}], " ", "+", " ", 
                  RowBox[{"2", "*", 
                   RowBox[{"u", "^", "3"}], "*", "\[Psi]", "*", "\n", 
                   "          ", 
                   RowBox[{"D", " ", ".", " ", "\[Psi]"}]}], " ", "+", " ", 
                  RowBox[{
                   RowBox[{"u", "^", "4"}], "*", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"D", " ", ".", " ", "\[Psi]"}], ")"}], "^", 
                    "2"}]}]}], ")"}]}]}], ")"}]}], " ", "-", " ", "\n", 
            "     ", 
            RowBox[{"8", "*", 
             RowBox[{"g", "^", "2"}], "*", 
             RowBox[{"V", "[", 
              RowBox[{"u", "*", "\[Psi]"}], "]"}]}]}], ")"}]}]}], "}"}]}], 
      "}"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"a29bd4bd-9590-4a11-9c54-1516abb79ecd"]
