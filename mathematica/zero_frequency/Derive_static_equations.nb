Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eqsEF", " ", "=", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Z\[Phi]Mikel", ",", " ", "Z2Mikel"}], "}"}], " ", "/.", "\n", 
     "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Z\[CurlyPhi]", " ", "->", " ", "Z\[Phi]"}], ",", " ", 
