Cell[CellGroupData[{

Cell["QNMs: q^2 for phiM = 0.8", "Subsection",ExpressionUUID->"85be96a0-d59a-4ca0-9a9b-c2ddd2824767"],

Cell["\<\
prec sets the working precision in decimal digits. NQNMs sets the number of \
retained modes; GetQNM computes the full spectrum.\
\>", "Text",ExpressionUUID->"6f01b1fe-447f-4ff6-b86f-85d88ce3f01e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"prec", " ", "=", " ", "30"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Nu", " ", "=", " ", 
   RowBox[{
    RowBox[{"Dimensions", "[", "fields", "]"}], "[", 
    RowBox[{"[", "3", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grid", " ", "=", " ", 
   RowBox[{"Cheb", "[", 
    RowBox[{"0", ",", " ", "1", ",", " ", "Nu", ",", " ", "prec"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"u", " ", "=", " ", 
    RowBox[{"grid", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"eigenfunctions", " ", "=", " ", "False"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"NQNMs", " ", "=", " ", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tol", " ", "=", " ", 
   RowBox[{"10", "^", 
    RowBox[{"-", "8"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.002464860362529*^9, 4.0024648618380203`*^9}, {
  4.002465921829114*^9, 4.002465927479281*^9}, {4.002467519816102*^9, 
  4.002467519888604*^9}, {4.0024690922232227`*^9, 
  4.002469092336483*^9}},ExpressionUUID->"3f32ebf8-3267-4bad-8572-\
cc3e64a5da3f"],

Cell["\<\
For each background in the loop range, select the ten nonzero eigenvalues of \
smallest absolute value.\
\>", "Text",ExpressionUUID->"6dcc32fd-fae0-4fb9-8d60-8736c0855bef"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"manymodes", " ", "=", " ", 
    RowBox[{"{", "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Monitor", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"number", " ", "=", " ", "n"}], ";", "\n", "    ", 
       RowBox[{"T", " ", "=", " ", 
        RowBox[{"thermo", "[", 
         RowBox[{"[", 
          RowBox[{"number", ",", " ", "1"}], "]"}], "]"}]}], ";", "\n", 
       "    ", 
       RowBox[{"QNM1", " ", "=", " ", 
        RowBox[{"GetQNM", "[", 
         RowBox[{"grid", ",", " ", 
          RowBox[{"fields", "[", 
           RowBox[{"[", "number", "]"}], "]"}], ",", " ", "VV", ",", " ", "T",
           ",", " ", "prec", ",", " ", "NQNMs", ",", " ", "eigenfunctions"}], 
         "]"}]}], ";", "\n", "\n", "    ", 
       RowBox[{"QNM1", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"QNM1", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"NumberQ", "[", "#", "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Abs", "[", "#", "]"}], " ", ">", " ", "tol"}]}], " ", 
           "&"}]}], "]"}]}], ";", "\n", "    ", 
       RowBox[{"qsquared", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"QNM1", " ", "===", " ", 
           RowBox[{"{", "}"}]}], ",", " ", 
          RowBox[{"{", "}"}], ",", "\n", "      ", 
          RowBox[{"MinimalBy", "[", 
           RowBox[{"QNM1", ",", " ", "Abs", ",", " ", 
            RowBox[{"Min", "[", 
             RowBox[{"NQNMs", ",", " ", 
              RowBox[{"Length", "[", "QNM1", "]"}]}], "]"}]}], "]"}]}], 
         "]"}]}], ";", "\n", "    ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "qsquared", "]"}], " ", "<", " ", "NQNMs"}], 
         ",", "\n", "      ", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<Background \>\"", ",", " ", "number", ",", " ", 
           "\"\<: only \>\"", ",", " ", 
           RowBox[{"Length", "[", "qsquared", "]"}], ",", " ", 
           "\"\< modes selected.\>\""}], "]"}]}], "]"}], ";", "\n", "    ", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"manymodes", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"thermo", "[", 
            RowBox[{"[", 
             RowBox[{"number", ",", " ", "7"}], "]"}], "]"}], ",", " ", 
           "qsquared"}], "}"}]}], "]"}], ";"}], "\n", "    ", ",", " ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "1", ",", " ", "Nbackgrounds"}], "}"}]}], "]"}],
     ",", "\n", "  ", "number"}], "\n", "]"}], ";"}]}], "Input",
 CellChangeTimes->{4.002464865690983*^9},
 CellLabel->"In[28]:=",ExpressionUUID->"a05f40cf-759e-4d04-93bc-3cf18abf423e"],

Cell["Extract the lightest mode from the same calculation.", "Text",ExpressionUUID->"93ccc8cb-a28b-4609-8e33-8c245945c8c2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dataqsquared", " ", "=", " ", 
   RowBox[{"Table", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"manymodes", "[", 
        RowBox[{"[", 
         RowBox[{"n", ",", " ", "1"}], "]"}], "]"}], ",", "\n", "   ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"manymodes", "[", 
           RowBox[{"[", 
            RowBox[{"n", ",", " ", "2"}], "]"}], "]"}], " ", "===", " ", 
          RowBox[{"{", "}"}]}], ",", " ", 
         RowBox[{"Missing", "[", "\"\<NoMode\>\"", "]"}], ",", " ", 
         RowBox[{"First", "[", 
          RowBox[{"manymodes", "[", 
           RowBox[{"[", 
            RowBox[{"n", ",", " ", "2"}], "]"}], "]"}], "]"}]}], "]"}]}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "1", ",", " ", 
       RowBox[{"Length", "[", "manymodes", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"b83b73da-1969-4f9c-958c-92e59b9f6803"],

Cell["\<\
Plot the real parts of the ten selected eigenvalues. The saved data retain \
their imaginary parts.\
\>", "Text",ExpressionUUID->"5b54b8d5-fb37-4b73-948e-84505481694e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"manymodespoints", " ", "=", " ", 
    RowBox[{"Flatten", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Table", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"manymodes", "[", 
              RowBox[{"[", 
               RowBox[{"n", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
             RowBox[{"Length", "[", 
              RowBox[{"manymodes", "[", 
               RowBox[{"[", 
                RowBox[{"n", ",", " ", "2"}], "]"}], "]"}], "]"}]}], "]"}], 
           ",", "\n", "      ", 
           RowBox[{"Re", "[", 
            RowBox[{"manymodes", "[", 
             RowBox[{"[", 
              RowBox[{"n", ",", " ", "2"}], "]"}], "]"}], "]"}]}], "}"}], 
         "]"}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "1", ",", " ", 
          RowBox[{"Length", "[", "manymodes", "]"}]}], "}"}]}], "]"}], ",", 
      " ", "1"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"plotmanyA", " ", "=", " ", 
  RowBox[{"ListPlot", "[", 
   RowBox[{"manymodespoints", ",", "\n", "  ", 
    RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "  ", 
    RowBox[{"FrameLabel", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
      "\"\<\[Phi]H\>\"", ",", " ", "\"\<(q/(2\[Pi]T))^2 at omega = 0\>\""}], 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{
    "PlotLabel", " ", "->", " ", "\"\<Theory A: ten lightest modes\>\""}], 
    ",", "\n", "  ", 
    RowBox[{"PlotStyle", " ", "->", " ", 
     RowBox[{"PointSize", "[", "0.007", "]"}]}], ",", " ", 
    RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
    RowBox[{"ImageSize", " ", "->", " ", "450"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.002469020329246*^9, 
  4.002469023273614*^9}},ExpressionUUID->"a6074098-6893-48dc-adef-\
9a8a081a88f4"],

