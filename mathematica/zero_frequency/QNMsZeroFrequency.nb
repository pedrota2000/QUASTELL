Cell["\<\
Select the mode with the largest real part among the retained eigenvalues and \
plot its real part. This follows the upper envelope if branches cross.\
\>", "Text",ExpressionUUID->"0185a4a7-8c48-4be5-be2c-ec3629979dd6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dataupperB", " ", "=", " ", 
    RowBox[{"Table", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"manymodes", "[", 
         RowBox[{"[", 
          RowBox[{"n", ",", " ", "1"}], "]"}], "]"}], ",", "\n", "   ", 
