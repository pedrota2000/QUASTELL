Cell["Plot the lightest nonzero mode.", "Text",ExpressionUUID->"d20237c8-cb7a-4264-9bb0-8cd30fdfe808"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"plotlightestB", " ", "=", " ", 
  RowBox[{"ListPlot", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{"Re", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], " ", "&"}], " ", "/@",
      " ", 
     RowBox[{"Select", "[", 
      RowBox[{"dataqsquared", ",", " ", 
       RowBox[{
        RowBox[{"NumberQ", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], " ", "&"}]}], "]"}]}], ",", 
    "\n", "  ", 
    RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "  ", 
    RowBox[{"FrameLabel", " ", "->", " ", 
