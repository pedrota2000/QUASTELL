Cell[CellGroupData[{
Cell["Zero-frequency QNMs", "Title",ExpressionUUID->"b4dbe6ab-961a-4ea5-8ffc-8d00e473cfa6"],

Cell["\<\
Evaluate the notebook from top to bottom. Place Background_N60_phiM_0.8.m and \
Background_N60_phiM_1.m in the same directory as this notebook. The spectrum \
is computed at omega = 0, with eigenvalue (q/(2\[Pi]T))^2.\
\>", "Text",
 CellChangeTimes->{{4.002467428700526*^9, 
  4.002467430451725*^9}},ExpressionUUID->"b3cc86ee-b616-4d87-98fa-\
6f0391116b19"],

