Cell[CellGroupData[{

Cell["Phase diagram", "Subsection",ExpressionUUID->"09fdfc0e-3283-4c82-8077-e655ba46dd85"],

Cell["\<\
Plot the rescaled energy density as a function of the rescaled temperature.\
\>", "Text",ExpressionUUID->"80e83b15-749a-4618-a0db-ac3b574572be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"plotphaseB", " ", "=", " ", 
  RowBox[{"ListPlot", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"thermo", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "/", 
        RowBox[{"thermo", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "3"}], "]"}], "]"}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"thermo", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "5"}], "]"}], "]"}], "/", 
        RowBox[{
         RowBox[{"thermo", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], "^", "4"}]}]}], 
      "}"}], "]"}], ",", "\n", "  ", 
    RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
    RowBox[{"FrameLabel", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
      "\"\<T/\[CapitalLambda]\>\"", ",", " ", 
       "\"\<\[ScriptCapitalE]/\[CapitalLambda]^4\>\""}], "}"}]}], ",", "\n", 
    "  ", 
    RowBox[{"PlotLabel", " ", "->", " ", "\"\<Theory B: phase diagram\>\""}], 
    ",", "\n", "  ", 
    RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
    RowBox[{"ImageSize", " ", "->", " ", "450"}]}], "]"}]}]], "Input",
