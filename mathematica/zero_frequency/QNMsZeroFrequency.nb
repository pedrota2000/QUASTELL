Cell[CellGroupData[{

Cell["QNMs: q^2 for phiM = 1", "Subsection",ExpressionUUID->"cdf8d962-3a19-426c-b852-ab62b5b72e87"],

Cell["\<\
prec sets the working precision in decimal digits. NQNMs sets the number of \
retained modes; GetQNM computes the full spectrum.\
\>", "Text",ExpressionUUID->"a35375ac-0b27-446f-97d5-ae4c79a90424"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"prec", " ", "=", " ", "30"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Nu", " ", "=", " ", 
   RowBox[{
    RowBox[{"Dimensions", "[", "fields", "]"}], "[", 
    RowBox[{"[", "3", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grid", " ", "=", " ", 
   RowBox[{"Cheb", "[", 
    RowBox[{"0", ",", " ", "1", ",", " ", "Nu", ",", " ", "prec"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"u", " ", "=", " ", 
    RowBox[{"grid", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"eigenfunctions", " ", "=", " ", "False"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"NQNMs", " ", "=", " ", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tol", " ", "=", " ", 
   RowBox[{"10", "^", 
    RowBox[{"-", "7"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.00246593854764*^9, 4.002465953653367*^9}, {
  4.002467456304863*^9, 
  4.00246745640399*^9}},ExpressionUUID->"bd967402-0131-49f7-9b8c-\
eaace7a5a93e"],

Cell["\<\
For each background in the loop range, select the ten nonzero eigenvalues of \
smallest absolute value.\
\>", "Text",ExpressionUUID->"deaf413e-8338-401e-8e16-f7591c85feac"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"manymodes", " ", "=", " ", 
    RowBox[{"{", "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Monitor", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"number", " ", "=", " ", "n"}], ";", "\n", "    ", 
       RowBox[{"T", " ", "=", " ", 
        RowBox[{"thermo", "[", 
         RowBox[{"[", 
          RowBox[{"number", ",", " ", "1"}], "]"}], "]"}]}], ";", "\n", 
       "    ", 
       RowBox[{"QNM1", " ", "=", " ", 
        RowBox[{"GetQNM", "[", 
         RowBox[{"grid", ",", " ", 
          RowBox[{"fields", "[", 
           RowBox[{"[", "number", "]"}], "]"}], ",", " ", "VV", ",", " ", "T",
           ",", " ", "prec", ",", " ", "NQNMs", ",", " ", "eigenfunctions"}], 
         "]"}]}], ";", "\n", "\n", "    ", 
       RowBox[{"QNM1", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"QNM1", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"NumberQ", "[", "#", "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Abs", "[", "#", "]"}], " ", ">", " ", "tol"}]}], " ", 
           "&"}]}], "]"}]}], ";", "\n", "    ", 
       RowBox[{"qsquared", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"QNM1", " ", "===", " ", 
           RowBox[{"{", "}"}]}], ",", " ", 
          RowBox[{"{", "}"}], ",", "\n", "      ", 
          RowBox[{"MinimalBy", "[", 
           RowBox[{"QNM1", ",", " ", "Abs", ",", " ", 
            RowBox[{"Min", "[", 
             RowBox[{"NQNMs", ",", " ", 
              RowBox[{"Length", "[", "QNM1", "]"}]}], "]"}]}], "]"}]}], 
         "]"}]}], ";", "\n", "    ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "qsquared", "]"}], " ", "<", " ", "NQNMs"}], 
         ",", "\n", "      ", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<Background \>\"", ",", " ", "number", ",", " ", 
           "\"\<: only \>\"", ",", " ", 
           RowBox[{"Length", "[", "qsquared", "]"}], ",", " ", 
           "\"\< modes selected.\>\""}], "]"}]}], "]"}], ";", "\n", "    ", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"manymodes", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"thermo", "[", 
            RowBox[{"[", 
             RowBox[{"number", ",", " ", "7"}], "]"}], "]"}], ",", " ", 
           "qsquared"}], "}"}]}], "]"}], ";"}], "\n", "    ", ",", " ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "1", ",", " ", "Nbackgrounds"}], "}"}]}], "]"}],
     ",", "\n", "  ", "number"}], "\n", "]"}], ";"}]}], "Input",
 CellLabel->"In[35]:=",ExpressionUUID->"004ecd13-b88c-42bf-b4da-dfacb1238569"],

Cell["Extract the lightest mode from the same calculation.", "Text",ExpressionUUID->"5f2d83b4-0bf8-441e-8e6c-aa0670d5ac8b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dataqsquared", " ", "=", " ", 
   RowBox[{"Table", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"manymodes", "[", 
        RowBox[{"[", 
         RowBox[{"n", ",", " ", "1"}], "]"}], "]"}], ",", "\n", "   ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"manymodes", "[", 
           RowBox[{"[", 
            RowBox[{"n", ",", " ", "2"}], "]"}], "]"}], " ", "===", " ", 
          RowBox[{"{", "}"}]}], ",", " ", 
         RowBox[{"Missing", "[", "\"\<NoMode\>\"", "]"}], ",", " ", 
         RowBox[{"First", "[", 
          RowBox[{"manymodes", "[", 
           RowBox[{"[", 
            RowBox[{"n", ",", " ", "2"}], "]"}], "]"}], "]"}]}], "]"}]}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "1", ",", " ", 
       RowBox[{"Length", "[", "manymodes", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[37]:=",ExpressionUUID->"82f5813a-83c6-4a90-923a-bcf06284aa8e"],

Cell["\<\
Plot the real parts of the ten selected eigenvalues. The saved data retain \
their imaginary parts.\
\>", "Text",ExpressionUUID->"80c342c2-48fb-42a5-9c41-e77fee6f8c51"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"manymodespoints", " ", "=", " ", 
    RowBox[{"Flatten", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Table", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"manymodes", "[", 
              RowBox[{"[", 
               RowBox[{"n", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
             RowBox[{"Length", "[", 
              RowBox[{"manymodes", "[", 
               RowBox[{"[", 
                RowBox[{"n", ",", " ", "2"}], "]"}], "]"}], "]"}]}], "]"}], 
           ",", "\n", "      ", 
           RowBox[{"Re", "[", 
            RowBox[{"manymodes", "[", 
             RowBox[{"[", 
              RowBox[{"n", ",", " ", "2"}], "]"}], "]"}], "]"}]}], "}"}], 
         "]"}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "1", ",", " ", 
          RowBox[{"Length", "[", "manymodes", "]"}]}], "}"}]}], "]"}], ",", 
      " ", "1"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"plotmanyB", " ", "=", " ", 
  RowBox[{"ListPlot", "[", 
   RowBox[{"manymodespoints", ",", "\n", "  ", 
    RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "  ", 
    RowBox[{"FrameLabel", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
      "\"\<\[Phi]H\>\"", ",", " ", "\"\<(q/(2\[Pi]T))^2 at omega = 0\>\""}], 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{
    "PlotLabel", " ", "->", " ", "\"\<Theory B: ten lightest modes\>\""}], 
    ",", "\n", "  ", 
    RowBox[{"PlotStyle", " ", "->", " ", 
     RowBox[{"PointSize", "[", "0.007", "]"}]}], ",", " ", 
    RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
    RowBox[{"ImageSize", " ", "->", " ", "450"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.002469032163474*^9, 
  4.002469034883135*^9}},ExpressionUUID->"b94e1bbd-599a-48e0-be2c-\
636d5a766e05"],

