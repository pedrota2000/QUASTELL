      RowBox[{"\[ScriptA]", " ", "->", " ", "0"}]}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"FileExistsQ", "[", "\"\<Background_N60_phiM_1.m\>\"", "]"}]}], 
    ",", "\n", "  ", 
    RowBox[{
     RowBox[{
     "Print", "[", "\"\<Missing file: Background_N60_phiM_1.m\>\"", "]"}], 
     ";", " ", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"thermo", ",", " ", "fields"}], "}"}], " ", "=", " ", 
   RowBox[{"Get", "[", "\"\<Background_N60_phiM_1.m\>\"", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Psi]Hlist", " ", "=", " ", 
   RowBox[{"thermo", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", "7"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Nbackgrounds", " ", "=", " ", 
   RowBox[{"Length", "[", "\[Psi]Hlist", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Number of backgrounds: \>\"", ",", " ", "Nbackgrounds"}], 
   "]"}], ";"}]}], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"ef88d978-1261-4b8a-b15c-5909f68f362f"],

