Cell[CellGroupData[{

Cell["Load background", "Subsection",ExpressionUUID->"43c3808c-b29a-4591-b842-b5e06cda3677"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"constants", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Kappa]", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"\[Phi]M", " ", "->", " ", 
       RowBox[{"10", "/", "10"}]}], ",", " ", 
