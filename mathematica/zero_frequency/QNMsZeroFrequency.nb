Cell["\<\
Select the mode with the largest real part among the retained eigenvalues and \
plot its real part. This follows the upper envelope if branches cross.\
\>", "Text",ExpressionUUID->"598a254d-006f-48ae-8084-5567cd088c8d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dataupperA", " ", "=", " ", 
    RowBox[{"Table", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"manymodes", "[", 
         RowBox[{"[", 
          RowBox[{"n", ",", " ", "1"}], "]"}], "]"}], ",", "\n", "   ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"manymodes", "[", 
            RowBox[{"[", 
             RowBox[{"n", ",", " ", "2"}], "]"}], "]"}], " ", "===", " ", 
           RowBox[{"{", "}"}]}], ",", " ", 
          RowBox[{"Missing", "[", "\"\<NoMode\>\"", "]"}], ",", "\n", "    ", 
          
          RowBox[{"First", "[", 
           RowBox[{"MaximalBy", "[", 
            RowBox[{
             RowBox[{"manymodes", "[", 
              RowBox[{"[", 
               RowBox[{"n", ",", " ", "2"}], "]"}], "]"}], ",", " ", "Re"}], 
            "]"}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "1", ",", " ", 
        RowBox[{"Length", "[", "manymodes", "]"}]}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{"plotupperA", " ", "=", " ", 
  RowBox[{"ListPlot", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{"Re", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], " ", "&"}], " ", "/@",
      " ", 
     RowBox[{"Select", "[", 
      RowBox[{"dataupperA", ",", " ", 
       RowBox[{
        RowBox[{"NumberQ", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], " ", "&"}]}], "]"}]}], ",", 
    "\n", "  ", 
    RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "  ", 
    RowBox[{"FrameLabel", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
      "\"\<\[Phi]H\>\"", ",", " ", 
       "\"\<(qmax/(2\[Pi]T))^2 at omega = 0\>\""}], "}"}]}], ",", "\n", "  ", 
    
    RowBox[{"PlotLabel", " ", "->", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<Theory A: \>\"", ",", " ", 
        RowBox[{"Superscript", "[", 
         RowBox[{"\"\<qmax\>\"", ",", " ", "2"}], "]"}]}], "}"}], "]"}]}], 
    ",", "\n", "  ", 
    RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
    RowBox[{"ImageSize", " ", "->", " ", "450"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.002468953759515*^9, 4.002468987113167*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"b66702b5-64b8-40c6-9246-96a85cb9baee"],

