Cell["Grid generation", "Subsection",ExpressionUUID->"a36cd7ba-6c13-4b84-9dbf-4963b8fce759"],

Cell["\<\
Generate the radial Chebyshev grid and its first and second derivative \
matrices.\
\>", "Text",ExpressionUUID->"b7c16a68-9307-4a0d-82d7-fc88b7f93a63"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Cheb", "[", 
    RowBox[{"xmin_", ",", "xmax_", ",", "Nu_", ",", "prec_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "M", ",", "x", ",", "c", ",", "X", ",", "\[CapitalDelta]X", ",", "D", 
       ",", "D2"}], "}"}], ",", "\n", "\t\t\t", 
     RowBox[{
      RowBox[{"M", "=", 
       RowBox[{"Nu", "-", "1"}]}], ";", "\n", "\t\t\t", 
      RowBox[{"x", " ", "=", " ", 
       RowBox[{"-", 
        RowBox[{"Cos", "[", 
         RowBox[{"\[Pi]", " ", 
          FractionBox[
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", "M"}], "]"}], "M"]}], "]"}]}]}], ";", "\n", 
      "\t\t\t", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", "M"}], "]"}]], 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", "2", "}"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{"1", ",", 
            RowBox[{"{", 
             RowBox[{"ii", ",", "1", ",", 
              RowBox[{"M", "-", "1"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}]}]}], ";", "\n", "\t\t\t", 
      RowBox[{"X", " ", "=", " ", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{"x", ",", 
          RowBox[{"{", 
           RowBox[{"ii", ",", "1", ",", "Nu"}], "}"}]}], "]"}], 
        "\[Transpose]"}]}], ";", "        ", "\n", "\t\t\t", 
      RowBox[{"\[CapitalDelta]X", " ", "=", " ", 
       RowBox[{"X", "-", 
        RowBox[{"X", "\[Transpose]"}]}]}], ";", "\n", "\t\t\t", 
      RowBox[{"D", "=", 
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"{", "c", "}"}], "\[Transpose]"}], ".", 
         SuperscriptBox[
          RowBox[{"{", "c", "}"}], 
          RowBox[{"-", "1"}]]}], 
        RowBox[{"\[CapitalDelta]X", "+", 
         RowBox[{"IdentityMatrix", "@", "Nu"}]}]]}], ";", "\n", "\t\t\t", 
      RowBox[{"D", " ", "=", " ", 
       RowBox[{"D", "-", 
        RowBox[{"DiagonalMatrix", "@", 
         RowBox[{"Total", "[", 
          RowBox[{"D", "\[Transpose]"}], "]"}]}]}]}], ";", "\n", "\t\t\t", 
      RowBox[{"x", " ", "=", " ", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"xmax", "+", "xmin", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"xmax", "-", "xmin"}], ")"}], " ", "x"}]}], ")"}]}]}], 
      ";", " ", "\n", "\t\t\t", 
      RowBox[{"D", " ", "=", " ", 
       FractionBox[
        RowBox[{"2", " ", "D"}], 
        RowBox[{"(", 
         RowBox[{"xmax", "-", "xmin"}], ")"}]]}], ";", "\n", "\t\t\t", 
      RowBox[{"SetPrecision", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "D", ",", " ", 
          RowBox[{"D", ".", "D"}]}], "}"}], ",", "prec"}], "]"}]}]}], "]"}]}],
   ";"}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"03bc8e53-38c3-4dfd-a2cb-9ceb2a196808"]
}, Open  ]],

