Cell[BoxData[
 RowBox[{
  RowBox[{"q", " ", "=", " ", "0"}], ";"}]], "Input",
 CellChangeTimes->{{4.002796417602519*^9, 4.002796418554307*^9}},
 CellLabel->
  "In[185]:=",ExpressionUUID->"31d3c401-3ba6-4523-a6ca-4ceca7a6df21"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"NQNMs", "=", "0"}], ";", 
  RowBox[{"eigenfunctions", "=", "False"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Im\[Omega]gappedCutoff", " ", "=", " ", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tol", "=", 
   SuperscriptBox["10", 
    RowBox[{"-", "5"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gappedModes", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solnumber", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetSharedVariable", "[", 
   RowBox[{
   "grid", ",", "fields", ",", "q", ",", "prec", ",", "NQNMs", ",", 
    "eigenfunctions", ",", "gappedModes", ",", "solnumber"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Monitor", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ParallelDo", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"T", " ", "=", " ", 
          RowBox[{"thermo", "[", 
           RowBox[{"[", 
            RowBox[{"n", ",", "1"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Track", " ", "the", " ", "conjugate", " ", "pairs"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"QNM1", " ", "=", 
          RowBox[{"GetQNM", "[", 
           RowBox[{"grid", ",", 
            RowBox[{"fields", "[", 
             RowBox[{"[", "n", "]"}], "]"}], ",", "VV", ",", "q", ",", "T", ",",
             "prec", ",", "NQNMs", ",", "eigenfunctions"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"gappedModes", ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", 
             RowBox[{"Select", "[", 
              RowBox[{"QNM1", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"Im", "[", "#", "]"}], "]"}], "<=", 
                  "Im\[Omega]gappedCutoff"}], "&&", 
                 RowBox[{"#", "!=", "\[Infinity]"}], "&&", 
                 RowBox[{"#", "!=", "0"}], "&&", 
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"Im", "[", "#", "]"}], "]"}], ">=", "tol"}]}], 
                "&"}]}], "]"}]}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
         
         RowBox[{"solnumber", "+=", "1"}], ";"}], "\[IndentingNewLine]", ",", 
        
        RowBox[{"{", 
         RowBox[{"n", ",", "1", ",", "Nbackgrounds"}], "}"}], ",", 
        RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}], ";"}], ",", 
     RowBox[{"{", 
      RowBox[{"solnumber", ",", 
       RowBox[{"gappedModes", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}]}], "]"}], ";"}], "//", 
  "AbsoluteTiming"}], "\[IndentingNewLine]"}], "Input",
 CellLabel->
  "In[186]:=",ExpressionUUID->"db878911-aac2-4191-a8a9-71e8d183df3c"],

