Cell[CellGroupData[{

Cell["Read the sound speed from the QNMs", "Item",
 CellChangeTimes->{{4.002885983919018*^9, 
  4.0028859888912992`*^9}},ExpressionUUID->"fa4c5971-104b-46d2-88e8-\
d257ce4108e7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nn", " ", "=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cs1Read", " ", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{
         FractionBox[
          RowBox[{"soundModeAll1", "[", 
           RowBox[{"[", 
            RowBox[{"n", ",", ";;"}], "]"}], "]"}], "qlist"], "[", 
         RowBox[{"[", "nn", "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"idTurning1", "-", "1"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{"Im", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"soundModeAll1", "[", 
            RowBox[{"[", 
             RowBox[{"n", ",", ";;"}], "]"}], "]"}], "qlist"], "[", 
          RowBox[{"[", "nn", "]"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "idTurning1", ",", "idInstability1"}], "}"}]}], 
      "]"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{
         FractionBox[
          RowBox[{"soundModeAll1", "[", 
           RowBox[{"[", 
            RowBox[{"n", ",", ";;"}], "]"}], "]"}], "qlist"], "[", 
         RowBox[{"[", "nn", "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", 
         RowBox[{"idInstability1", "+", "1"}], ",", 
         RowBox[{"idInstability2", "-", "1"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{"Im", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"soundModeAll1", "[", 
            RowBox[{"[", 
             RowBox[{"n", ",", ";;"}], "]"}], "]"}], "qlist"], "[", 
          RowBox[{"[", "nn", "]"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
