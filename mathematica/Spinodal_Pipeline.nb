         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"xmax", "+", "xmin", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"xmax", "-", "xmin"}], ")"}], " ", "x"}]}], ")"}]}]}], ";",
        " ", "\n", "\t\t\t", 
       RowBox[{"D", " ", "=", " ", 
        FractionBox[
         RowBox[{"2", " ", "D"}], 
         RowBox[{"(", 
          RowBox[{"xmax", "-", "xmin"}], ")"}]]}], ";", "\n", "\t\t\t", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "D", ",", " ", 
           RowBox[{"D", ".", "D"}]}], "}"}], ",", "prec"}], "]"}]}]}], 
     "]"}]}], ";"}], "\n", "\t\t\t"}], "\n", 
