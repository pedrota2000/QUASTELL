          RowBox[{"[", "number", "]"}], "]"}], "]"}], ",", 
        " ", "\"\<   (background \>\"", ",", " ", "number", ",", 
        " ", "\"\<)\>\""}], "}"}], "]"}], ",", " ", "Bold", ",", " ", "14"}], 
    "]"}], "]"}], ";"}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"Row", "[", 
