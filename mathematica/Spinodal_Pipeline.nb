Cell[CellGroupData[{

Cell["Compute finite q QNM for sound and relevant gapped modes", "Subsection",
 CellChangeTimes->{{4.0027981162917347`*^9, 
  4.002798124238154*^9}},ExpressionUUID->"cbe68a21-107b-47fc-bfc6-\
9ea34d2f7b2b"],

Cell["Load the q=0 data for the relevant gapped modes", "Text",
 CellChangeTimes->{{4.002798019561125*^9, 4.002798040134112*^9}, 
   4.0027980986590633`*^9},ExpressionUUID->"648e8965-84d6-4216-b5c2-\
a1dcce40aebb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"LightMode1", ",", "LightMode2"}], "}"}], "=", 
   RowBox[{
   "Import", "[", "\"\<./QNM_data/datawgapped_phiM=0.8_phiQ=10._Nz_40_.m\>\"",
     "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.984739220084655*^9, 3.984739224426156*^9}, {
   3.992331188748763*^9, 3.99233119538274*^9}, {3.9930294930061493`*^9, 
   3.993029518722628*^9}, {3.99309223253071*^9, 3.9930922334196987`*^9}, {
