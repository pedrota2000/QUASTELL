   "This", " ", "is", " ", "the", " ", "desired", " ", "precision", " ", 
    "for", " ", 
    RowBox[{"QNMs", ".", " ", "Running"}], " ", "times", " ", "scale", " ", 
    "fast", " ", "with", " ", 
    RowBox[{"it", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"prec", " ", "=", "30"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Nu", "=", 
    RowBox[{
     RowBox[{"Dimensions", "[", "fields", "]"}], "[", 
     RowBox[{"[", "3", "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"u", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{
       RowBox[{"Reverse", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], "+", 
           RowBox[{
            FractionBox["1", "2"], " ", 
            RowBox[{"Cos", "[", 
             FractionBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{"j", "-", "1"}], ")"}], " ", "\[Pi]"}], 
              RowBox[{"Nu", "-", "1"}]], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "Nu"}], "}"}]}], "]"}], "]"}], ",", 
       "prec"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Du", " ", "=", " ", 
     RowBox[{
      RowBox[{"NDSolve`FiniteDifferenceDerivative", "[", 
       RowBox[{"1", ",", " ", "u", ",", " ", 
        RowBox[{"\"\<DifferenceOrder\>\"", " ", "->", 
         " ", "\"\<Pseudospectral\>\""}]}], "]"}], 
      "[", "\"\<DifferentiationMatrix\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Du2", " ", "=", " ", 
     RowBox[{
      RowBox[{"NDSolve`FiniteDifferenceDerivative", "[", 
       RowBox[{"2", ",", "u", ",", " ", 
        RowBox[{"\"\<DifferenceOrder\>\"", " ", "->", 
         " ", "\"\<Pseudospectral\>\""}]}], "]"}], 
      "[", "\"\<DifferentiationMatrix\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"grid", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", "Du", ",", "Du2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"u", " ", "=", " ", 
     RowBox[{"grid", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"u", "//", "Precision"}]}]}]], "Input",
 CellChangeTimes->{
  4.00279447714419*^9, {4.002794561820363*^9, 4.002794578166733*^9}, {
