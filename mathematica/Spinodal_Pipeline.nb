     "[", "\"\<./background_data/phiM=0.8_phiQ=10._a=0._N_40_200_\\\n\
backgrounds.m\>\"", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"VV", "[", "\[Phi]_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "3"}], " ", "-", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"3", " ", 
       RowBox[{"\[Phi]", "^", "2"}]}], ")"}], "/", "2"}], " ", "-", " ", 
    RowBox[{
     RowBox[{"\[Phi]", "^", "4"}], "/", "3"}], " ", "-", " ", 
    RowBox[{
     RowBox[{"(", "\n", "   ", 
      RowBox[{"4", " ", 
       RowBox[{"\[ScriptA]", "^", "2"}], " ", 
       RowBox[{"\[Phi]", "^", "16"}]}], ")"}], "/", "3"}], " ", "+", " ", 
    "\n", "   ", 
    RowBox[{
     RowBox[{"2", "/", "3"}], " ", 
     RowBox[{"\[Phi]", "^", "12"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[ScriptA]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"1", "/", 
           RowBox[{"\[Phi]M", "^", "2"}]}], " ", "+", " ", 
          RowBox[{"72", "/", "\[Phi]Q"}]}], ")"}]}], " ", "-", " ", "\n", 
       "      ", 
       RowBox[{"2", "/", 
        RowBox[{"\[Phi]Q", "^", "2"}]}]}], ")"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"\[Phi]", "^", "6"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"\[Phi]M", "^", "4"}]}], ")"}]}], " ", "-", " ", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"3", " ", 
          RowBox[{"\[Phi]M", "^", "2"}]}], ")"}]}], " ", "-", " ", "\n", 
       "      ", 
       RowBox[{"2", "/", "\[Phi]Q"}]}], ")"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"(", "\n", "   ", 
      RowBox[{"8", " ", "\[ScriptA]", " ", 
       RowBox[{"\[Phi]", "^", "14"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], " ", "+", " ", 
         RowBox[{"12", " ", "\[ScriptA]", " ", "\[Phi]Q"}]}], ")"}]}], ")"}], 
     "/", 
     RowBox[{"(", "\n", "   ", 
      RowBox[{"3", " ", "\[Phi]Q"}], ")"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"\[Phi]", "^", "8"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "4"}], " ", "\[ScriptA]"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"(", "\n", "      ", 
         RowBox[{
          RowBox[{"72", " ", 
           RowBox[{"\[Phi]M", "^", "2"}]}], " ", "-", " ", 
          RowBox[{"16", " ", 
           RowBox[{"\[Phi]M", "^", "4"}]}], " ", "+", " ", "\[Phi]Q"}], ")"}],
         "/", 
        RowBox[{"(", "\n", "      ", 
         RowBox[{"12", " ", 
          RowBox[{"\[Phi]M", "^", "4"}], " ", "\[Phi]Q"}], ")"}]}]}], ")"}]}],
     " ", "+", " ", 
    RowBox[{
     RowBox[{"\[Phi]", "^", "10"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[ScriptA]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"4", "/", "3"}], " ", "-", " ", "\n", "         ", 
          RowBox[{"8", "/", 
           RowBox[{"\[Phi]M", "^", "2"}]}]}], ")"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{"27", " ", "+", " ", 
            RowBox[{"\[Phi]Q", "/", 
             RowBox[{"\[Phi]M", "^", "2"}]}]}], ")"}]}], ")"}], "/", 
        RowBox[{"(", "\n", "      ", 
         RowBox[{"3", " ", 
          RowBox[{"\[Phi]Q", "^", "2"}]}], ")"}]}]}], ")"}]}]}], " ", "/.", 
   " ", "constants"}]}], "\n", 
 RowBox[{
  RowBox[{"\[ScriptW]Hydro", "[", 
   RowBox[{
   "q_", ",", " ", "cs2_", ",", " ", "\n", "  ", "T\[CapitalGamma]_"}], "]"}],
   " ", ":=", " ", 
