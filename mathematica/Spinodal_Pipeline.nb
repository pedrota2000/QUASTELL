Cell[CellGroupData[{

Cell["QNMs", "Subsubsection",ExpressionUUID->"1dddcad7-3ac3-41ad-907b-16aa62b0aa87"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"NQNMs", " ", "=", " ", "0"}], ";", " ", 
  RowBox[{"eigenfunctions", " ", "=", " ", "False"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gap", " ", "=", " ", 
   RowBox[{"10", "^", 
    RowBox[{"-", "3"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qcutoff", " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "\[Pi]"}], ")"}]}], 
    RowBox[{"(*", "2.5", "*)"}], " ", "1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"QNMs", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gappedModes", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"solnumber", " ", "=", " ", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Im\[Omega]gappedCutoff", " ", "=", " ", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tol", " ", "=", " ", 
   RowBox[{"10", "^", 
    RowBox[{"-", "1"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Monitor", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"solnumber", " ", "+=", " ", "1"}], ";", "\n", "     ", 
         RowBox[{"q", " ", "=", " ", 
          RowBox[{"qlist", "[", 
           RowBox[{"[", "n", "]"}], "]"}]}], ";", "\n", "     ", 
         RowBox[{"(*", 
          RowBox[{"Track", " ", "the", " ", "conjugate", " ", "pairs"}], 
          "*)"}], "\n", "     ", 
         RowBox[{"QNM1", " ", "=", " ", "\n", "      ", 
          RowBox[{"GetQNM", "[", 
           RowBox[{"grid", ",", " ", 
            RowBox[{"fields", "[", 
             RowBox[{"[", "number", "]"}], "]"}], ",", " ", "VV", ",", " ", 
            "q", ",", " ", "T", ",", " ", "prec", ",", " ", "NQNMs", ",", " ",
             "\n", "       ", "eigenfunctions"}], "]"}]}], ";", "\n", "     ",
          "\n", "     ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", "q", "]"}], " ", "<", " ", "qcutoff"}], ",", 
           "\n", "      ", 
           RowBox[{
            RowBox[{"modes", " ", "=", " ", 
             RowBox[{"EFTModes", "[", 
              RowBox[{"[", "n", "]"}], "]"}]}], ";"}], "\n", "      ", ",", 
           "\n", "      ", 
           RowBox[{
            RowBox[{"modes", " ", "=", " ", 
             RowBox[{"QNMs", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}]}], ";"}]}], "\n", "      ", 
          "]"}], ";", "\n", "     ", "\n", "     ", 
         RowBox[{"aux", " ", "=", " ", 
          RowBox[{"{", "}"}]}], ";", " ", 
         RowBox[{"avail", " ", "=", " ", "QNM1"}], ";", "\n", 
         RowBox[{"Do", "[", "\n", "  ", 
          RowBox[{
           RowBox[{
            RowBox[{"id", " ", "=", " ", 
             RowBox[{"First", "[", 
              RowBox[{"Ordering", "[", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"avail", " ", "-", " ", 
                  RowBox[{"modes", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", " ", "1"}], 
               "]"}], "]"}]}], ";", "\n", "  ", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"aux", ",", " ", 
              RowBox[{"avail", "[", 
               RowBox[{"[", "id", "]"}], "]"}]}], "]"}], ";", "\n", "  ", 
            RowBox[{"avail", " ", "=", " ", 
             RowBox[{"Delete", "[", 
              RowBox[{"avail", ",", " ", "id"}], "]"}]}], ";"}], "\n", "  ", ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "1", ",", " ", 
             RowBox[{"Length", "[", "modes", "]"}]}], "}"}]}], "]"}], ";", 
         "\n", "     ", "\n", "     ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"QNMs", ",", " ", "aux"}], "]"}], ";", "\n", "     ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"gappedModes", ",", " ", "\n", "      ", 
           RowBox[{"Select", "[", 
            RowBox[{"QNM1", ",", " ", "\n", "       ", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"Im", "[", "#", "]"}], "]"}], " ", "<=", " ", 
                "Im\[Omega]gappedCutoff"}], " ", "&&", " ", 
               RowBox[{"#", " ", "!=", " ", "\[Infinity]"}], " ", "&&", " ", 
               RowBox[{"#", " ", "!=", "\n", "           ", "0"}], " ", "&&", 
               " ", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"Im", "[", "#", "]"}], "]"}], " ", ">=", " ", 
                "tol"}]}], " ", "&"}]}], "]"}]}], "]"}], ";"}], "\n", "     ",
         "\n", "     ", ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "1", ",", " ", "Nq"}], "}"}]}], "]"}], ";"}], 
     ",", " ", 
     RowBox[{"{", 
      RowBox[{"solnumber", ",", " ", 
       RowBox[{"QNMs", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}], ",", " ", "\n", "    ", 
       RowBox[{"gappedModes", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}]}], "]"}], ";"}], " ", "//",
   " ", "AbsoluteTiming"}], "\n", 
 RowBox[{"Clear", "[", 
  RowBox[{"aux", ",", " ", "id", ",", " ", "q", ",", " ", "QNM1"}], "]"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Precision", "[", "QNMs", "]"}], ",", " ", 
   RowBox[{"Precision", "[", "gappedModes", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{4.002985013350648*^9, 
  4.002985014795746*^9}},ExpressionUUID->"b5cdf0ba-d81d-4ca5-99a2-\
8c3da258988a"],

