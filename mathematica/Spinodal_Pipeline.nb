Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Alpha]2SoundImTable", " ", "=", " ", "\n", "    ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Im", "[", 
         RowBox[{
          RowBox[{"soundModeAll1", "[", 
           RowBox[{"[", 
            RowBox[{"n", ",", " ", ";;"}], "]"}], "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"cs1Read", "[", 
            RowBox[{"[", "n", "]"}], "]"}], " ", "qlist"}]}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"qlist", "^", "2"}], ")"}]}], ")"}], "[", 
      RowBox[{"[", "\n", "         ", "m", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "1", ",", " ", "Nq"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "1", ",", " ", "Nbackgrounds"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Alpha]2SoundImTableThermo", " ", "=", " ", "\n", "    ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Im", "[", 
         RowBox[{
          RowBox[{"soundModeAll1", "[", 
           RowBox[{"[", 
            RowBox[{"n", ",", " ", ";;"}], "]"}], "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"cs2", "[", 
             RowBox[{"[", "n", "]"}], "]"}], "]"}], " ", "qlist"}]}], "]"}], "/", 
        RowBox[{"(", "\n", "           ", 
         RowBox[{"qlist", "^", "2"}], ")"}]}], ")"}], "[", 
      RowBox[{"[", "m", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "1", ",", " ", "Nq"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "1", ",", " ", "Nbackgrounds"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Alpha]2SoundImTableThermoNz80", " ", "=", " ", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Im", "[", "\n", "       ", 
         RowBox[{
          RowBox[{"soundModeAll1", "[", 
           RowBox[{"[", 
            RowBox[{"n", ",", " ", ";;"}], "]"}], "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"cs2Nz80", "[", 
             RowBox[{"[", "n", "]"}], "]"}], "]"}], " ", "qlist"}]}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"qlist", "^", "2"}], ")"}]}], ")"}], "[", 
      RowBox[{"[", "\n", "    ", "m", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "1", ",", " ", "Nq"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "1", ",", " ", "Nbackgrounds"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"legends", " ", "=", " ", "\n", "    ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"\"\<q/T = \>\"", " ", "<>", " ", "\n", "        ", 
      RowBox[{"ToString", "[", "\n", "          ", 
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"2", " ", "\[Pi]", " ", 
           RowBox[{"qlist", "[", 
            RowBox[{"[", "n", "]"}], "]"}]}], "]"}], ",", " ", "2", ",", " ", 
         "\n", "            ", 
         RowBox[{"ExponentFunction", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{"Null", " ", "&"}], ")"}]}]}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "1", ",", " ", "\n", "        ", 
       RowBox[{"Length", "[", "\[Alpha]2SoundImTable", "]"}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
