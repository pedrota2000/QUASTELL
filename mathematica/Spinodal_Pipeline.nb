Cell[CellGroupData[{

Cell["\[CapitalGamma]", "Subsection",
 CellChangeTimes->{{4.002887695739254*^9, 
  4.002887696302722*^9}},ExpressionUUID->"102da147-376a-456c-bca7-\
45dfcd583f48"],

Cell["\<\
If higher number of grid points Nu speed of sound is loaded, results improve \
without having to increase Nu for the QNM computation\
\>", "Text",
 CellChangeTimes->{{4.002984833400766*^9, 
  4.0029848784128647`*^9}},ExpressionUUID->"924967cc-c92d-47b1-81a6-\
33c522bba86e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"thermoNz80", " ", "=", " ", 
   RowBox[{
    RowBox[{
    "Import", 
     "[", "\"\<./background_data/phiM=0.8_phiQ=10._a=0._N_80_200_backgrounds.\
m\>\"", "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cs2Nz80", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"D\[Psi]HFD", " ", ".", " ", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"thermoNz80", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "/", 
        RowBox[{"thermoNz80", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "3"}], "]"}], "]"}]}], "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"D\[Psi]HFD", " ", ".", " ", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"thermoNz80", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "/", 
        RowBox[{
         RowBox[{"thermoNz80", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], "^", "3"}]}], 
       "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Dimensions", "[", "cs2Nz80", "]"}], ",", " ", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"cs2Nz80", "/", "cs2"}], " ", "-", " ", "1"}], "]"}], "]"}]}], 
  "}"}]}], "Input",
 CellChangeTimes->{{4.002984824806324*^9, 
  4.002984825438746*^9}},ExpressionUUID->"7ba2fb35-7be4-4eb7-b723-\
27b23c645782"],

