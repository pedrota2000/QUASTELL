    RowBox[{"NDSolve`FiniteDifferenceDerivative", "[", 
     RowBox[{"1", ",", " ", "\[Psi]Hlist", ",", " ", 
      RowBox[{"\"\<DifferenceOrder\>\"", " ", "->", " ", "8"}]}], "]"}], 
    "[", "\"\<DifferentiationMatrix\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cs2FromE", " ", "=", " ", 
    RowBox[{
     RowBox[{"D\[Psi]HFD", " ", ".", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"thermo", "[", 
         RowBox[{"[", 
