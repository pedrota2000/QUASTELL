         RowBox[{"thermo", "[", 
          RowBox[{"[", 
           RowBox[{";;", " ", ",", " ", "3"}], "]"}], "]"}], "^", "4"}]}], 
       ")"}]}]}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"cs2", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"D\[Psi]HFD", " ", ".", " ", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"thermo", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "/", 
        RowBox[{"thermo", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "3"}], "]"}], "]"}]}], "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"D\[Psi]HFD", " ", ".", " ", "\n", "     ", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"thermo", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "/", 
        RowBox[{
         RowBox[{"thermo", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], "^", "3"}]}], 
       "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Zeta]overs", " ", "=", " ", "\n", "  ", 
   RowBox[{
    RowBox[{"1", "/", "\[Pi]"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"D\[Psi]HFD", " ", ".", " ", 
       RowBox[{"(", 
