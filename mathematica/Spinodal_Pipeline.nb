Cell["All gapped modes at q = 0 (parallel)", "Subsection",ExpressionUUID->"47dcd30c-c356-411d-9fc5-3423fd89010e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"numberProcessors", " ", "=", " ", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"$KernelCount", " ", "==", " ", "0"}], ",", " ", 
    RowBox[{"LaunchKernels", "[", "numberProcessors", "]"}]}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.002795894226141*^9, 4.002795894820074*^9}, {
  4.002796419612747*^9, 4.002796422924676*^9}},
