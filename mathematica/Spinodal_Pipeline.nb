Cell["Numerical parameters", "Subsection",ExpressionUUID->"8922b753-3b9e-41e1-8a15-3469daf8477e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"--", 
    RowBox[{"--", " ", 
     RowBox[{
      RowBox[{"Backgrounds", " ", "--"}], "--"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Nz", " ", "=", " ", "80"}], ";", " ", 
    RowBox[{"precision", " ", "=", " ", "100"}], ";"}], 
   "                      ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"radial", " ", "Gauss"}], "-", 
      RowBox[{"Lobatto", " ", "points"}]}], ",", " ", 
     RowBox[{"working", " ", "precision"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Lambda]", " ", "=", " ", "1"}], ";", " ", 
    RowBox[{"tol", " ", "=", " ", 
     RowBox[{"10", "^", 
      RowBox[{"(", 
       RowBox[{"-", "precision"}], ")"}]}]}], ";", " ", 
    RowBox[{"maxit", " ", "=", " ", "19"}], ";"}], "      ", 
   RowBox[{"(*", " ", 
    RowBox[{"Newton", " ", "relaxation"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Psi]Hmin", ",", " ", "\[Psi]Hmax", ",", " ", "N\[Psi]H"}], 
      "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"5", "/", "10"}], ",", 
       RowBox[{"177", "/", "100"}], ",", "200"}], "}"}]}], ";"}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "range", " ", "and", " ", "number", " ", "of", " ", "backgrounds"}], " ", 
    "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", " ", "Phase"}]}], " ", 
     RowBox[{"diagram", ":", " ", 
      RowBox[{"FindRoot", " ", 
       RowBox[{
        RowBox[{"guesses", " ", "--"}], "--"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Psi]HturningGuess", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"16", "/", "10"}]}], "}"}]}], ";"}], "    ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"T", "'"}], 
       RowBox[{"(", "\[Psi]H", ")"}]}], " ", "=", " ", "0"}], ",", " ", 
     RowBox[{"the", " ", "two", " ", "spinodal", " ", "points"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"stabilitySwitch", " ", "=", " ", "True"}], ";"}], "         ", 
   RowBox[{"(*", " ", 
    RowBox[{"False", " ", "if", " ", 
     RowBox[{"s", "'"}], 
