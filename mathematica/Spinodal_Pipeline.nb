Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "fields", ",", " ", "thermo", ",", " ", "constants", ",", " ", 
      "\[ScriptCapitalE]H", ",", " ", "\[ScriptCapitalE]L", ",", " ", "\n", 
      "   ", "Tc", ",", " ", "\[Psi]Hlist"}], "}"}], " ", "=", " ", "\n", 
    "  ", 
    RowBox[{
    "Import", 
     "[", "\"\<./background_data/phiM=0.8_phiQ=10._a=0._N_40_200_\\\n\
backgrounds.m\>\"", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"VV", "[", "\[Phi]_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "3"}], " ", "-", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"3", " ", 
       RowBox[{"\[Phi]", "^", "2"}]}], ")"}], "/", "2"}], " ", "-", " ", 
    RowBox[{
     RowBox[{"\[Phi]", "^", "4"}], "/", "3"}], " ", "-", " ", 
    RowBox[{
     RowBox[{"(", "\n", "   ", 
      RowBox[{"4", " ", 
       RowBox[{"\[ScriptA]", "^", "2"}], " ", 
       RowBox[{"\[Phi]", "^", "16"}]}], ")"}], "/", "3"}], " ", "+", " ", 
    "\n", "   ", 
    RowBox[{
     RowBox[{"2", "/", "3"}], " ", 
     RowBox[{"\[Phi]", "^", "12"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[ScriptA]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"1", "/", 
           RowBox[{"\[Phi]M", "^", "2"}]}], " ", "+", " ", 
          RowBox[{"72", "/", "\[Phi]Q"}]}], ")"}]}], " ", "-", " ", "\n", 
       "      ", 
       RowBox[{"2", "/", 
        RowBox[{"\[Phi]Q", "^", "2"}]}]}], ")"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"\[Phi]", "^", "6"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"\[Phi]M", "^", "4"}]}], ")"}]}], " ", "-", " ", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"3", " ", 
          RowBox[{"\[Phi]M", "^", "2"}]}], ")"}]}], " ", "-", " ", "\n", 
       "      ", 
       RowBox[{"2", "/", "\[Phi]Q"}]}], ")"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"(", "\n", "   ", 
      RowBox[{"8", " ", "\[ScriptA]", " ", 
       RowBox[{"\[Phi]", "^", "14"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], " ", "+", " ", 
         RowBox[{"12", " ", "\[ScriptA]", " ", "\[Phi]Q"}]}], ")"}]}], ")"}], 
     "/", 
     RowBox[{"(", "\n", "   ", 
      RowBox[{"3", " ", "\[Phi]Q"}], ")"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"\[Phi]", "^", "8"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "4"}], " ", "\[ScriptA]"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"(", "\n", "      ", 
         RowBox[{
          RowBox[{"72", " ", 
           RowBox[{"\[Phi]M", "^", "2"}]}], " ", "-", " ", 
          RowBox[{"16", " ", 
           RowBox[{"\[Phi]M", "^", "4"}]}], " ", "+", " ", "\[Phi]Q"}], ")"}],
         "/", 
        RowBox[{"(", "\n", "      ", 
         RowBox[{"12", " ", 
          RowBox[{"\[Phi]M", "^", "4"}], " ", "\[Phi]Q"}], ")"}]}]}], ")"}]}],
     " ", "+", " ", 
    RowBox[{
     RowBox[{"\[Phi]", "^", "10"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[ScriptA]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"4", "/", "3"}], " ", "-", " ", "\n", "         ", 
          RowBox[{"8", "/", 
           RowBox[{"\[Phi]M", "^", "2"}]}]}], ")"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{"27", " ", "+", " ", 
            RowBox[{"\[Phi]Q", "/", 
             RowBox[{"\[Phi]M", "^", "2"}]}]}], ")"}]}], ")"}], "/", 
        RowBox[{"(", "\n", "      ", 
         RowBox[{"3", " ", 
          RowBox[{"\[Phi]Q", "^", "2"}]}], ")"}]}]}], ")"}]}]}], " ", "/.", 
   " ", "constants"}]}], "\n", 
 RowBox[{
  RowBox[{"\[ScriptW]Hydro", "[", 
   RowBox[{
   "q_", ",", " ", "cs2_", ",", " ", "\n", "  ", "T\[CapitalGamma]_"}], "]"}],
   " ", ":=", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"Sqrt", "[", "cs2", "]"}], " ", "q"}], " ", "-", " ", 
    RowBox[{"I", " ", "\[Pi]", " ", "T\[CapitalGamma]", " ", 
     RowBox[{"q", "^", "2"}]}]}], ")"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"D\[Psi]H", " ", "=", " ", "\n", "  ", 
    RowBox[{
     RowBox[{"Cheb", "[", 
      RowBox[{
       RowBox[{"\[Psi]Hlist", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
       RowBox[{"\[Psi]Hlist", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}], ",", " ", 
       RowBox[{"Length", "[", "\[Psi]Hlist", "]"}], ",", " ", "\n", "    ", 
       "100"}], "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"local", " ", "8", "th"}], "-", 
     RowBox[{"order", " ", "finite"}], "-", 
     RowBox[{"difference", " ", 
      RowBox[{"d", "/", "d\[Psi]H"}], " ", 
      RowBox[{"(", 
       RowBox[{"9", "-", 
        RowBox[{"point", " ", "stencil", " ", "on", " ", "\[Psi]Hlist"}]}], 
       ")"}]}]}], ",", " ", 
    RowBox[{"used", " ", "for", " ", "all", " ", "thermodynamic", " ", 
     RowBox[{"derivatives", ":", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "global", " ", "spectral", " ", "D\[Psi]H", " ", "is", " ",
         "off", " ", 
        RowBox[{"by", " ", "~", "1"}], "e"}], "-", 
       RowBox[{"4", " ", "in", " ", "d", " ", "log", " ", 
        RowBox[{"s", "/", "d\[Psi]H"}]}]}]}]}], ",", " ", 
    RowBox[{"which", " ", "near", " ", "the", " ", "poles", " ", "of", " ", 
     RowBox[{"c_s", "^", "2"}], " ", "makes", " ", 
     RowBox[{"c_s", "^", "2"}], " ", "and", " ", 
     RowBox[{"\[Zeta]", "/", "s"}], " ", "noisy"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"D\[Psi]HFD", " ", "=", " ", 
   RowBox[{
    RowBox[{"NDSolve`FiniteDifferenceDerivative", "[", 
     RowBox[{"1", ",", " ", "\[Psi]Hlist", ",", " ", 
      RowBox[{"\"\<DifferenceOrder\>\"", " ", "->", " ", "8"}]}], "]"}], 
    "[", "\"\<DifferentiationMatrix\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cs2FromE", " ", "=", " ", 
    RowBox[{
     RowBox[{"D\[Psi]HFD", " ", ".", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"thermo", "[", 
         RowBox[{"[", 
          RowBox[{";;", " ", ",", " ", "6"}], "]"}], "]"}], "/", 
        RowBox[{
         RowBox[{"thermo", "[", 
          RowBox[{"[", 
           RowBox[{";;", " ", ",", " ", "3"}], "]"}], "]"}], "^", "4"}]}], 
       ")"}]}], "/", "\n", "  ", 
     RowBox[{"D\[Psi]HFD", " ", ".", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"thermo", "[", 
         RowBox[{"[", 
