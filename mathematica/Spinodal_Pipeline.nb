96efd9c11502"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Nq", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"nmin", ",", "nmax"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "6"}], ",", 
     RowBox[{"-", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"qlist", " ", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", " ", "\[Pi]"}]], " ", 
    SuperscriptBox["10", 
     RowBox[{"Range", "[", 
      RowBox[{"nmin", ",", "nmax", ",", 
       FractionBox[
        RowBox[{"nmax", "-", "nmin"}], 
        RowBox[{"Nq", "-", "1"}]]}], "]"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"2", " ", "\[Pi]", " ", "qlist"}], "//", "N"}], "//", "Log10"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qmin", ",", "qmax"}], "}"}], " ", "=", " ", 
   RowBox[{"qlist", "[", 
    RowBox[{"[", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"-", "1"}]}], "}"}], "]"}], "]"}]}], ";"}]}], "Input",
