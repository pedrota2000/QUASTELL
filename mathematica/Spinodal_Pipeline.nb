     "in", " ", "the", " ", "range"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Psi]HstabilityGuess", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"16", "/", "10"}]}], "}"}]}], ";"}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"s", "'"}], 
       RowBox[{"(", "\[Psi]H", ")"}]}], " ", "=", " ", "0"}], ",", " ", 
     RowBox[{"only", " ", "used", " ", "if", " ", "stabilitySwitch"}]}], " ", 
    "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", " ", "Log"}]}], "-", 
     RowBox[{"scale", " ", "momentum", " ", 
      RowBox[{"grid", ":", " ", 
       RowBox[{"2", "\[Pi]", " ", "q", " ", "from", " ", 
        RowBox[{"10", "^", "nmin"}], " ", "to", " ", 
        RowBox[{"10", "^", 
         RowBox[{
          RowBox[{"nmax", " ", "--"}], "--"}]}]}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Nq", " ", "=", " ", "10"}], ";", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nmin", ",", " ", "nmax"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "6"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", " ", "Backgrounds"}]}], " ", "shown", " ", "in", " ", 
     "the", " ", "plots", " ", "as", " ", "a", " ", "function", " ", "of", " ", 
     RowBox[{
      RowBox[{"q", " ", "--"}], "--"}]}], " ", "*)"}], "\n", 
