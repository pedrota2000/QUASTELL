 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Cheb", "[", 
     RowBox[{"xmin_", ",", "xmax_", ",", "Nu_", ",", "prec_"}], "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "M", ",", "x", ",", "c", ",", "X", ",", "\[CapitalDelta]X", ",", "D", ",",
         "D2"}], "}"}], ",", "\n", "\t\t\t", 
      RowBox[{
       RowBox[{"M", "=", 
        RowBox[{"Nu", "-", "1"}]}], ";", "\n", "\t\t\t", 
       RowBox[{"x", " ", "=", " ", 
        RowBox[{"-", 
         RowBox[{"Cos", "[", 
          RowBox[{"\[Pi]", " ", 
           FractionBox[
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", "M"}], "]"}], "M"]}], "]"}]}]}], ";", "\n", 
       "\t\t\t", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", "M"}], "]"}]], 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", "2", "}"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{"1", ",", 
             RowBox[{"{", 
              RowBox[{"ii", ",", "1", ",", 
               RowBox[{"M", "-", "1"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}]}], ";", "\n", "\t\t\t", 
       RowBox[{"X", " ", "=", " ", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{"x", ",", 
           RowBox[{"{", 
            RowBox[{"ii", ",", "1", ",", "Nu"}], "}"}]}], "]"}], 
         "\[Transpose]"}]}], ";", "        ", "\n", "\t\t\t", 
       RowBox[{"\[CapitalDelta]X", " ", "=", " ", 
        RowBox[{"X", "-", 
         RowBox[{"X", "\[Transpose]"}]}]}], ";", "\n", "\t\t\t", 
       RowBox[{"D", "=", 
        FractionBox[
         RowBox[{
          RowBox[{
           RowBox[{"{", "c", "}"}], "\[Transpose]"}], ".", 
          SuperscriptBox[
           RowBox[{"{", "c", "}"}], 
           RowBox[{"-", "1"}]]}], 
         RowBox[{"\[CapitalDelta]X", "+", 
          RowBox[{"IdentityMatrix", "@", "Nu"}]}]]}], ";", "\n", "\t\t\t", 
       RowBox[{"D", " ", "=", " ", 
        RowBox[{"D", "-", 
         RowBox[{"DiagonalMatrix", "@", 
          RowBox[{"Total", "[", 
           RowBox[{"D", "\[Transpose]"}], "]"}]}]}]}], ";", "\n", "\t\t\t", 
       RowBox[{"x", " ", "=", " ", 
