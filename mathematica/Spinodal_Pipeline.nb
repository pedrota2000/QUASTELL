Cell[CellGroupData[{

Cell["Get turning and instability switch points (if there are any)", "Item",
 CellChangeTimes->{{4.002794633803088*^9, 4.0027946524987907`*^9}, {
  4.002794872079741*^9, 
  4.00279487432907*^9}},ExpressionUUID->"7777ec31-9a82-43e7-99af-\
43158da7bc54"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Tof\[Psi]H", " ", "=", " ", 
   RowBox[{"Interpolation", "[", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"\[Psi]Hlist", ",", " ", 
       RowBox[{
        RowBox[{"thermo", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "/", 
        RowBox[{"thermo", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "3"}], "]"}], "]"}]}]}], "}"}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sof\[Psi]H", " ", "=", " ", 
   RowBox[{"Interpolation", "[", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"\[Psi]Hlist", ",", " ", 
       RowBox[{
        RowBox[{"thermo", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "/", 
        RowBox[{
         RowBox[{"thermo", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], "^", "3"}]}]}], 
      "}"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"turning1", " ", "=", " ", 
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Tof\[Psi]H", "'"}], "[", "\[Psi]Ht1", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Psi]Ht1", ",", " ", 
       RowBox[{"\[Psi]HturningGuess", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"turning2", " ", "=", " ", 
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Tof\[Psi]H", "'"}], "[", "\[Psi]Ht2", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Psi]Ht2", ",", " ", 
       RowBox[{"\[Psi]HturningGuess", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"turnings", " ", "=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{"turning1", ",", " ", "turning2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{"stabilitySwitch", ",", "\n", "  ", 
    RowBox[{
     RowBox[{"turningStability1", " ", "=", " ", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"sof\[Psi]H", "'"}], "[", "\[Psi]Ht1", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\[Psi]Ht1", ",", " ", 
          RowBox[{"\[Psi]HstabilityGuess", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", "\n", 
     "  ", 
     RowBox[{"turningStability2", " ", "=", " ", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"sof\[Psi]H", "'"}], "[", "\[Psi]Ht2", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\[Psi]Ht2", ",", " ", 
          RowBox[{"\[Psi]HstabilityGuess", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", "\n", 
     "  ", 
     RowBox[{"turningsStability", " ", "=", " ", 
      RowBox[{"Join", "[", 
       RowBox[{"turningStability1", ",", " ", "turningStability2"}], 
       "]"}]}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "turning1", ",", " ", "turning2", ",", " ", "turningStability1", ",", " ", 
    "turningStability2"}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{4.002794657838923*^9, 4.002794685163837*^9}, {
   4.0027947333688917`*^9, 4.002794739079278*^9}, {4.002794896541563*^9, 
   4.002794897586956*^9}, {4.00279493030735*^9, 4.002794932460503*^9}, 
   4.002796755452664*^9},
 CellLabel->
  "In[147]:=",ExpressionUUID->"8908657b-62af-471d-a286-f3c354e92a22"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"idTurning1", " ", "=", " ", 
   RowBox[{"Length", "[", 
    RowBox[{"Select", "[", 
     RowBox[{"\[Psi]Hlist", ",", " ", 
      RowBox[{
       RowBox[{"#", " ", "<", " ", 
        RowBox[{"(", 
         RowBox[{"\[Psi]Ht1", " ", "/.", " ", "turnings"}], ")"}]}], " ", 
       "&"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"idTurning2", " ", "=", " ", 
