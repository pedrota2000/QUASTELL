            RowBox[{"V", "|", 
             RowBox[{
              RowBox[{"Derivative", "[", "_", "]"}], "[", "V", "]"}]}], ")"}],
            "[", "a_", "]"}], ":>", "a"}], ",", "Infinity"}], "]"}]}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<scalar symbol detected: \>\"", ",", "scalarField"}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"jsym", "[", "s_String", "]"}], ":=", 
     RowBox[{"Symbol", "[", 
      RowBox[{"\"\<JuliaOut`\>\"", "<>", "s"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"juliaNames", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", "m_", "]"}], "[", "V", "]"}], "[", "_", 
         "]"}], ":>", 
        RowBox[{"jsym", "[", 
