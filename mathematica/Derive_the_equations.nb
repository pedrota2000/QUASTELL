          "\"\<RESIDUAL NONZERO - coefficients incomplete:\>\"", ",", "Red"}],
           "]"}], ",", "residual"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}]}], ",", 
      RowBox[{"Print", "[", "\"\<completeness: OK\>\"", "]"}]}], "]"}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"===", "===", "===", "===", "===", "===", 
