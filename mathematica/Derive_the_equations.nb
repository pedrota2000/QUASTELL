Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["G", "TI"], "\[Mu]\[Nu]"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["T", "TI"], "\[Mu]\[Nu]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "G_{\\mu\\nu} = T_{\\mu\\nu}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], " ", "where", " ", 
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "\[Mu]\[Nu]"], " ", "\[LongEqual] ", "2", 
         SubscriptBox["\[PartialD]", "\[Mu]"], "\[Phi]", 
         SubscriptBox["\[PartialD]", "\[Nu]"], "\[Phi]", "-", 
         SubscriptBox["\[PartialD]", "\[Alpha]"], "\[Phi]", 
         SuperscriptBox["\[PartialD]", "\[Alpha]"], "\[Phi]", 
         SubscriptBox[
          StyleBox["g", "TI"], "\[Mu]\[Nu]"], "-", "2", 
         StyleBox["V", "TI"], 
         RowBox[{"(", "\[Phi]", ")"}], 
         SubscriptBox[
          StyleBox["g", "TI"], "\[Mu]\[Nu]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "T_{\\mu\\nu} \\,=\\, 2\\partial_\\mu \\phi \\partial_\\nu \\phi - \
\\partial_\\alpha \\phi \\partial^\\alpha \\phi g_{\\mu\\nu} - 2V(\\phi) \
g_{\\mu\\nu}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"]}], 
  TraditionalForm]],ExpressionUUID->"b5415506-aab9-4ad0-a49c-fdd39d764c7c"]], \
