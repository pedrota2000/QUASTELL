      RowBox[{"2.", " ", "JULIA", " ", "NAME", " ", "RULES"}]}], "===", "===",
      "===", "===", "===", "===", "=="}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"scalarField", "=", 
