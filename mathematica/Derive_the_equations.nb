          RowBox[{"Derivative", "[", "m_", "]"}], "[", "f", "]"}], "[", "u", 
         "]"}], ":>", 
        RowBox[{"jsym", "[", 
         RowBox[{
          RowBox[{"StringJoin", "[", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"\"\<d\>\"", ",", "m"}], "]"}], "]"}], "<>", 
          "\"\<f\>\""}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", "m_", "]"}], "[", "g", "]"}], "[", "u", 
         "]"}], ":>", 
        RowBox[{"jsym", "[", 
         RowBox[{
          RowBox[{"StringJoin", "[", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"\"\<d\>\"", ",", "m"}], "]"}], "]"}], "<>", 
          "\"\<g\>\""}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"f", "[", "u", "]"}], ":>", 
        RowBox[{"jsym", "[", "\"\<f0\>\"", "]"}]}], ",", 
       RowBox[{
        RowBox[{"g", "[", "u", "]"}], ":>", 
        RowBox[{"jsym", "[", "\"\<g0\>\"", "]"}]}], ",", 
       RowBox[{"\[Chi]", ":>", 
        RowBox[{"jsym", "[", "\"\<chi\>\"", "]"}]}], ",", 
       RowBox[{"q", ":>", 
        RowBox[{"jsym", "[", "\"\<q\>\"", "]"}]}], ",", 
       RowBox[{"T", ":>", 
        RowBox[{"jsym", "[", "\"\<T\>\"", "]"}]}], ",", 
       RowBox[{"Pi", ":>", 
        RowBox[{"jsym", "[", "\"\<pi\>\"", "]"}]}], ",", 
       RowBox[{"u", ":>", 
        RowBox[{"jsym", "[", "\"\<x\>\"", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Complex", "[", 
         RowBox[{"a_", ",", "b_"}], "]"}], ":>", 
        RowBox[{"a", "+", 
         RowBox[{"b", " ", 
          RowBox[{"jsym", "[", "\"\<im\>\"", "]"}]}]}]}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"toJulia", "[", "e_", "]"}], ":=", 
     RowBox[{"StringReplace", "[", 
      RowBox[{
       RowBox[{"ToString", "[", 
        RowBox[{
         RowBox[{"e", "/.", " ", "juliaNames"}], ",", "InputForm"}], "]"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<JuliaOut`\>\"", "->", "\"\<\>\""}], ",", 
         RowBox[{"\"\<Sqrt[\>\"", "->", "\"\<sqrt(\>\""}], ",", 
         RowBox[{"\"\<[\>\"", "->", "\"\<(\>\""}], ",", 
         RowBox[{"\"\<]\>\"", "->", "\"\<)\>\""}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"===", "===", "===", "===", "===", "===", 
     RowBox[{"==", 
      RowBox[{"3.", " ", "GUARD"}]}], "===", "===", "===", "===", "===", "===",
      "=="}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"leftovers", "=", 
     RowBox[{"Complement", "[", 
      RowBox[{
       RowBox[{"DeleteDuplicates", "@", 
        RowBox[{"Flatten", "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"StringCases", "[", 
            RowBox[{
             RowBox[{"toJulia", "[", 
              RowBox[{"c", "[", 
               RowBox[{"a", ",", "b", ",", "n", ",", "p"}], "]"}], "]"}], ",", 
             RowBox[{
             "RegularExpression", "[", "\"\<[A-Za-z_][A-Za-z0-9_]*\\\\(\>\"", 
              "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"p", ",", "0", ",", "P"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"a", ",", "1", ",", "Nf"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"b", ",", "1", ",", "Nf"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "0", ",", "2"}], "}"}]}], "]"}]}]}], ",", 
       RowBox[{"{", "\"\<sqrt(\>\"", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
