  RowBox[{"toFourier", " ", "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox["f_", 
      TagBox[
       RowBox[{"(", 
        RowBox[{"a_", ",", "b_", ",", "c_"}], ")"}],
       Derivative],
      MultilineFunction->None], "[", 
     RowBox[{"t", ",", "u", ",", "x"}], "]"}], "\[RuleDelayed]", 
    RowBox[{
     RowBox[{
      SuperscriptBox["f", 
       TagBox[
        RowBox[{"(", "b", ")"}],
        Derivative],
       MultilineFunction->None], "[", "u", "]"}], " ", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       RowBox[{"{", 
        RowBox[{"t", ",", "a"}], "}"}]], 
      RowBox[{
       SubscriptBox["\[PartialD]", 
        RowBox[{"{", 
         RowBox[{"x", ",", "c"}], "}"}]], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Omega]", " ", "t"}], "-", 
           RowBox[{"k", " ", "x"}]}], ")"}]}]]}]}]}]}]}], ";"}]], "Input",
 CellLabel->"In[75]:=",ExpressionUUID->"d48c571b-8bbc-424b-9c36-d4cfb6cd96b2"],

