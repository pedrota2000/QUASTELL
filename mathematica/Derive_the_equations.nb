       RowBox[{"Abort", "[", "]"}]}], ",", 
      RowBox[{"Print", "[", "\"\<conversion: OK\>\"", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"===", "===", "===", "===", "===", "===", 
     RowBox[{"==", 
      RowBox[{"4.", " ", "EMIT"}]}], "===", "===", "===", "===", "===", "===",
      "=="}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"emit", "=", 
     RowBox[{"StringJoin", "[", 
      RowBox[{"\"\<# generated from Mathematica - P = \>\"", ",", 
       RowBox[{"ToString", "[", "P", "]"}], ",", "\"\<, Nf = \>\"", ",", 
       RowBox[{"ToString", "[", "Nf", "]"}], ",", "\"\<\\n\>\"", ",", 
       "\"\<using LinearAlgebra\\n\\n\>\"", ",", 
       "\"\<function build_Mtildes(x, D, D2, f0, g0, phi0, Vfuncs, q, T, chi; \
nu = 1.0)\\n\>\"", ",", "\"\<    N = length(x); Nf = \>\"", ",", 
       RowBox[{"ToString", "[", "Nf", "]"}], ",", "\"\<; P = \>\"", ",", 
       RowBox[{"ToString", "[", "P", "]"}], ",", "\"\<\\n\>\"", ",", 
       "\"\<    phi  = x.^nu .* phi0\\n\>\"", ",", 
       "\"\<    dphi = nu .* x.^(nu-1) .* phi0 .+ x.^nu .* (D * phi0)\\n\>\"",
        ",", "\"\<    df = D*f0; dg = D*g0\\n\>\"", ",", 
       "\"\<    VV = Vfuncs[1].(phi); VVp = Vfuncs[2].(phi); VVpp = \
Vfuncs[3].(phi)\\n\>\"", ",", "\"\<    Dm = (I(N), D, D2)\\n\>\"", ",", 
       "\"\<    rows(a) = (a-1)*N+1 : a*N\\n\>\"", ",", 
       "\"\<    Mt = [zeros(ComplexF64, Nf*N, Nf*N) for _ in 0:P]\\n\\n\>\"", 
       ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ex", "=", 
             RowBox[{"c", "[", 
              RowBox[{"a", ",", "b", ",", "n", ",", "p"}], "]"}]}], "}"}], 
           ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"ex", "===", "0"}], ",", "\"\<\>\"", ",", 
             RowBox[{"StringJoin", "[", 
              RowBox[{"\"\<    cc = @. \>\"", ",", 
               RowBox[{"toJulia", "[", "ex", "]"}], ",", "\"\<\\n\>\"", ",", 
               "\"\<    Mt[\>\"", ",", 
               RowBox[{"ToString", "[", 
                RowBox[{"p", "+", "1"}], "]"}], ",", "\"\<][rows(\>\"", ",", 
               RowBox[{"ToString", "[", "a", "]"}], ",", "\"\<), rows(\>\"", 
               ",", 
               RowBox[{"ToString", "[", "b", "]"}], ",", 
               "\"\<)] .+= Diagonal(cc) * Dm[\>\"", ",", 
               RowBox[{"ToString", "[", 
                RowBox[{"n", "+", "1"}], "]"}], ",", "\"\<]\\n\\n\>\""}], 
              "]"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"p", ",", "0", ",", "P"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", "1", ",", "Nf"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"b", ",", "1", ",", "Nf"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "0", ",", "2"}], "}"}]}], "]"}], ",", 
       "\"\<    d = Nf*N\\n\>\"", ",", 
       "\"\<    Idb = Matrix{ComplexF64}(I, d, d)\\n\>\"", ",", 
       "\"\<    M0 = zeros(ComplexF64, P*d, P*d)\\n\>\"", ",", 
       "\"\<    M1 = zeros(ComplexF64, P*d, P*d)\\n\>\"", ",", 
       "\"\<    blk(i,j) = ((i-1)*d+1:i*d, (j-1)*d+1:j*d)\\n\>\"", ",", 
       "\"\<    for j in 1:P\\n\>\"", ",", 
       "\"\<        M0[blk(1,j)...] .= Mt[j]\\n\>\"", ",", 
       "\"\<    end\\n\>\"", ",", "\"\<    for i in 2:P\\n\>\"", ",", 
       "\"\<        M0[blk(i,i)...]   .=  Idb\\n\>\"", ",", 
       "\"\<        M1[blk(i,i-1)...] .= -Idb\\n\>\"", ",", 
       "\"\<    end\\n\>\"", ",", "\"\<    M1[blk(1,P)...] .= Mt[P+1]\\n\>\"",
        ",", "\"\<    return M0, M1, Mt\\n\>\"", ",", "\"\<end\\n\\n\>\"", 
       ",", "\"\<function qnm_spectrum(x, D, D2, f0, g0, phi0, Vfuncs, q, T, \
chi;\\n\>\"", ",", 
       "\"\<                      nu = 1.0, cutoff = 50.0)\\n\>\"", ",", 
       "\"\<    M0, M1, _ = build_Mtildes(x, D, D2, f0, g0, phi0, Vfuncs, q, \
T, chi; nu = nu)\\n\>\"", ",", "\"\<    w = eigvals(M0, -M1)\\n\>\"", ",", 
       "\"\<    w = filter(z -> isfinite(z) && abs(z) < cutoff, w)\\n\>\"", 
       ",", "\"\<    return sort(w, by = z -> abs(imag(z)))\\n\>\"", ",", 
       "\"\<end\\n\>\""}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"outfile", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"\<Mtildes.jl\>\""}], 
       "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"outfile", ",", "emit", ",", "\"\<Text\>\""}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<wrote \>\"", ",", "outfile", ",", "\"\<  (\>\"", ",", 
      RowBox[{"StringLength", "[", "emit", "]"}], ",", "\"\< chars)\>\""}], 
     "]"}], ";"}]}]}]], "Input",
