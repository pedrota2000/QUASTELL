    RowBox[{
    "Each", " ", "of", " ", "those", " ", "are", " ", "going", " ", "to", " ",
      "represent", " ", "different", " ", "power", " ", "of", " ", 
     "\[Omega]"}], ",", " ", 
    RowBox[{"or", " ", "equivalently"}], ",", " ", 
    RowBox[{"of", " ", "\[Lambda]"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "We", " ", "can", " ", "then", " ", "construct", " ", "the", " ", 
     "generalized", " ", "eiganvalue", " ", "equation", " ", "as", " ", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["M", "0"], "+", 
       RowBox[{"\[Omega]", " ", 
        SubscriptBox["M", "1"]}]}], ")"}], "Z"}], " ", "=", " ", "0"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "With", " ", "the", " ", "following", " ", "definition", " ", "fo", " ", 
    "the", " ", "matrices"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"In", " ", "our", " ", "case"}], ",", " ", 
