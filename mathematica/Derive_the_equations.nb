         RowBox[{"Together", "[", "#", "]"}], "]"}], "&"}], "/@", 
       "masterEqs"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"masterEqs", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Numerator", "[", 
        RowBox[{"Together", "[", "#", "]"}], "]"}], "&"}], "/@", 
      "masterEqs"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqs", "=", 
     RowBox[{"Expand", "[", "masterEqs", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fields", "=", 
     RowBox[{"{", 
      RowBox[{"Z\[Phi]", ",", "Z2"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Nf", "=", 
     RowBox[{"Length", "[", "fields", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"P", "=", 
     RowBox[{"Max", "[", 
      RowBox[{"Exponent", "[", 
       RowBox[{"eqs", ",", "\[Omega]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<P = \>\"", ",", "P", ",", "\"\<,  Nf = \>\"", ",", "Nf"}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "memoized", " ", "so", " ", "Simplify", " ", "runs", " ", "once", " ", 
     "per", " ", "coefficient"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Clear", "[", "c", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"c", "[", 
      RowBox[{"a_", ",", "b_", ",", "n_", ",", "p_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"c", "[", 
       RowBox[{"a", ",", "b", ",", "n", ",", "p"}], "]"}], "=", 
      RowBox[{"Simplify", "@", 
       RowBox[{"Coefficient", "[", 
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{
           RowBox[{"eqs", "[", 
            RowBox[{"[", "a", "]"}], "]"}], ",", "\[Omega]", ",", "p"}], 
          "]"}], ",", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"fields", "[", 
             RowBox[{"[", "b", "]"}], "]"}], "[", "u", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "n"}], "}"}]}], "]"}]}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"===", "===", "===", "===", "===", "===", 
     RowBox[{"==", 
      RowBox[{"1.", " ", "COMPLETENESS", " ", "CHECK"}]}], "===", "===", "===",
      "===", "===", "===", "=="}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"residual", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"eqs", "[", 
          RowBox[{"[", "a", "]"}], "]"}], "-", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Omega]", "^", "p"}], " ", 
