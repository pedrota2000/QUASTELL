       RowBox[{"(", 
        RowBox[{"16", " ", 
         RowBox[{"Pi", "^", "2"}], " ", 
         RowBox[{"q", "^", "2"}], " ", 
         RowBox[{"T", "^", "2"}], " ", 
         RowBox[{"u", "^", "2"}], " ", 
         RowBox[{
          RowBox[{"g", "[", "u", "]"}], "^", "2"}]}], ")"}]}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<same bracket in both denominators? \>\"", ",", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"dens", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"48", " ", 
          RowBox[{"Pi", "^", "2"}], " ", 
          RowBox[{"q", "^", "2"}], " ", 
          RowBox[{"T", "^", "2"}], " ", 
          RowBox[{"u", "^", "2"}], " ", 
          RowBox[{
           RowBox[{"g", "[", "u", "]"}], "^", 
           RowBox[{"(", 
            RowBox[{"3", "/", "2"}], ")"}]}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"u", " ", 
             RowBox[{
              RowBox[{"g", "'"}], "[", "u", "]"}]}], "-", 
            RowBox[{"2", " ", 
             RowBox[{"g", "[", "u", "]"}]}]}], ")"}], " ", "Bfac"}], ")"}]}], 
       "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<degree of B in omega: \>\"", ",", 
      RowBox[{"Exponent", "[", 
       RowBox[{"Bfac", ",", "\[Omega]"}], "]"}]}], "]"}], ";"}], "        ", 
   RowBox[{"(*", 
    RowBox[{"expect", " ", "2"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", "map"}]}]}]}]}], " ", "to", " ", "a", " ", "genuine", 
      " ", "polynomial", " ", "ring", " ", "so", " ", "Cancel", " ", "can", 
      " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"work", "--"}], "--"}], "--"}], "--"}], "--"}], " ", "g"}], 
     "->", 
     RowBox[{
      RowBox[{
       RowBox[{"G", "^", "2"}], " ", "turns", " ", "every", " ", "half"}], 
      "-", 
      RowBox[{
      "power", " ", "of", " ", "g", " ", "into", " ", "an", " ", "integer", 
       " ", "power", " ", "of", " ", "G"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"toPoly", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"g", "''"}], "[", "u", "]"}], "->", "GPP"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"g", "'"}], "[", "u", "]"}], "->", "GP"}], ",", 
       RowBox[{
        RowBox[{"g", "[", "u", "]"}], "->", 
        RowBox[{"G", "^", "2"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"f", "''"}], "[", "u", "]"}], "->", "FPP"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"f", "'"}], "[", "u", "]"}], "->", "FP"}], ",", 
       RowBox[{
        RowBox[{"f", "[", "u", "]"}], "->", "F"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Phi]", "''"}], "[", "u", "]"}], "->", "PPP"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Phi]", "'"}], "[", "u", "]"}], "->", "PP"}], ",", 
       RowBox[{
        RowBox[{"\[Phi]", "[", "u", "]"}], "->", "PH"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"V", "''"}], "[", 
         RowBox[{"\[Phi]", "[", "u", "]"}], "]"}], "->", "VVpp"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"V", "'"}], "[", 
         RowBox[{"\[Phi]", "[", "u", "]"}], "]"}], "->", "VVp"}], ",", 
       RowBox[{
        RowBox[{"V", "[", 
         RowBox[{"\[Phi]", "[", "u", "]"}], "]"}], "->", "VV"}]}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"fromPoly", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"GPP", "->", 
        RowBox[{
         RowBox[{"g", "''"}], "[", "u", "]"}]}], ",", 
       RowBox[{"GP", "->", 
        RowBox[{
         RowBox[{"g", "'"}], "[", "u", "]"}]}], ",", 
       RowBox[{"G", "->", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"g", "[", "u", "]"}], "]"}]}], ",", 
       RowBox[{"FPP", "->", 
        RowBox[{
         RowBox[{"f", "''"}], "[", "u", "]"}]}], ",", 
       RowBox[{"FP", "->", 
        RowBox[{
         RowBox[{"f", "'"}], "[", "u", "]"}]}], ",", 
       RowBox[{"F", "->", 
        RowBox[{"f", "[", "u", "]"}]}], ",", 
       RowBox[{"PPP", "->", 
        RowBox[{
         RowBox[{"\[Phi]", "''"}], "[", "u", "]"}]}], ",", 
       RowBox[{"PP", "->", 
        RowBox[{
         RowBox[{"\[Phi]", "'"}], "[", "u", "]"}]}], ",", 
       RowBox[{"PH", "->", 
        RowBox[{"\[Phi]", "[", "u", "]"}]}], ",", 
       RowBox[{"VVpp", "->", 
        RowBox[{
         RowBox[{"V", "''"}], "[", 
         RowBox[{"\[Phi]", "[", "u", "]"}], "]"}]}], ",", 
       RowBox[{"VVp", "->", 
        RowBox[{
         RowBox[{"V", "'"}], "[", 
         RowBox[{"\[Phi]", "[", "u", "]"}], "]"}]}], ",", 
       RowBox[{"VV", "->", 
        RowBox[{"V", "[", 
         RowBox[{"\[Phi]", "[", "u", "]"}], "]"}]}]}], "}"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numsP", "=", 
     RowBox[{"PowerExpand", "[", 
      RowBox[{"nums", "/.", " ", "toPoly"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"BfacP", "=", 
     RowBox[{"PowerExpand", "[", 
      RowBox[{"Bfac", "/.", " ", "toPoly"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"quot", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Cancel", "[", 
        RowBox[{"#", "/", "BfacP"}], "]"}], "&"}], "/@", "numsP"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<divides exactly? \>\"", ",", 
      RowBox[{"And", "@@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"PolynomialQ", "[", 
           RowBox[{"#", ",", 
            RowBox[{"{", 
             RowBox[{
             "G", ",", "GP", ",", "F", ",", "FP", ",", "PP", ",", "PH", ",", 
              "VV", ",", "VVp", ",", "VVpp", ",", "u", ",", "\[Omega]"}], 
             "}"}]}], "]"}], "&"}], "/@", "quot"}], ")"}]}]}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<degree in omega after dividing: \>\"", ",", 
      RowBox[{"Exponent", "[", 
       RowBox[{"quot", ",", "\[Omega]"}], "]"}]}], "]"}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{"hope", ":", "1"}], "*)"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.9962412610172997`*^9, 3.9962412610182996`*^9}},
